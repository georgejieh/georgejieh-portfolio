---
interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
---

{home ? (
  <footer data-testid="footer" class="home-footer">
    <div class="home-footer__inner">
      <a href="/" class="home-footer__brand">George Jieh</a>
      <p>AI/ML engineering / LLM evaluation / San Francisco</p>
      <p>&copy; {new Date().getFullYear()} George Jieh</p>
    </div>
  </footer>
) : (
  <footer data-testid="footer" class="border-t border-border/50 py-8">
    <div class="flex flex-col items-center justify-between gap-4 md:flex-row">
      <p class="font-mono text-xs text-muted">
        &copy; {new Date().getFullYear()} George Jieh. Built with Astro.
      </p>
      <p class="font-mono text-xs text-muted">
        georgejieh.dev<span class="animate-blink text-accent">_</span>
      </p>
    </div>
  </footer>
)}