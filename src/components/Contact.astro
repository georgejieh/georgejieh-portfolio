---
import Social from '@components/ui/Social.astro';
---

<section
  data-testid="contact"
  id="contact"
  class="home-contact"
>
  <div class="home-contact__inner">
    <div class="home-section__heading home-section__heading--contact">
      <p>04 / Contact</p>
      <h2>Let's talk about the work.</h2>
    </div>

    <p class="home-contact__copy">
      Open to AI/ML engineering and research roles. Also available for freelance
      AI training, evaluation, and annotation work on weekends.
    </p>

    <a
      href="mailto:contact@georgejieh.dev"
      class="home-contact__email"
    >
      contact@georgejieh.dev
      <span aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </span>
    </a>

    <div class="home-contact__socials">
      <Social />
    </div>
  </div>
</section>