---
import Social from '@components/ui/Social.astro';
---

<section
  data-testid="contact"
  id="contact"
  class="flex flex-col items-start justify-center py-20 md:py-28"
>
  <div class="mb-10 flex w-full items-baseline gap-4">
    <h2 class="font-mono text-sm tracking-widest text-accent uppercase">04 / Contact</h2>
    <div class="h-px flex-1 bg-border"></div>
  </div>

  <div class="w-full max-w-2xl">
    <p class="mb-6 leading-relaxed text-white/80">
      Open to AI/ML engineering and research roles. Also available for freelance
      AI training, evaluation, and annotation work on weekends.
    </p>

    <a
      href="mailto:contact@georgejieh.dev"
      class="inline-flex items-center gap-2 border border-accent bg-accent/10 px-6 py-3 font-mono text-sm font-medium text-accent transition-all hover:bg-accent hover:text-black md:text-base"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
        />
      </svg>
      contact@georgejieh.dev
    </a>

    <div class="mt-8">
      <Social />
    </div>
  </div>
</section>