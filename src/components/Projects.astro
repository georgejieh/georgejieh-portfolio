---
import Card from '@components/ui/Card.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects', ({ data }) => {
  return data.featured;
});

const sortedProjects = projects.sort((a, b) => (a.data.sortOrder || 0) - (b.data.sortOrder || 0));
---

<section
  data-testid="projects"
  id="projects"
  class="flex flex-col items-start justify-center py-20 md:py-28"
>
  <div class="mb-4 flex w-full items-baseline gap-4">
    <h2 class="font-mono text-sm tracking-widest text-accent uppercase">03 / Selected Work</h2>
    <div class="h-px flex-1 bg-border"></div>
  </div>

  <p class="mb-10 max-w-2xl text-sm leading-relaxed text-muted">
    Three projects, honestly labeled. One shipped and cleaned for production;
    two working systems being rebuilt to the same standard.
  </p>

  <div class="flex w-full flex-col gap-6 lg:gap-8">
    {sortedProjects.map((project, i) => (
      <Card
        title={project.data.title}
        description={project.data.description}
        longDescription={project.data.longDescription}
        tags={project.data.tags}
        status={project.data.status}
        url={project.data.link}
        repo={project.data.repo}
        index={i}
      />
    ))}
  </div>

  <div class="mt-12 w-full">
    <a
      href="https://github.com/georgejieh?tab=repositories"
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-2 font-mono text-sm text-muted transition-colors hover:text-accent"
    >
      &rarr; View all repositories on GitHub
    </a>
  </div>
</section>