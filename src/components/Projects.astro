---
import Card from '@components/ui/Card.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects', ({ data }) => {
  return data.featured;
});

const sortedProjects = projects.sort((a, b) => (a.data.sortOrder || 0) - (b.data.sortOrder || 0));
---

<section
  data-testid="projects"
  id="projects"
  class="home-section home-projects"
>
  <div class="home-section__heading">
    <p>03 / Work</p>
    <h2>Selected systems, shown honestly.</h2>
  </div>

  <p class="home-projects__intro">
    Two shipped systems and one active rebuild, each labeled by its current
    state and open for a closer look.
  </p>

  <div class="home-projects__list">
    {sortedProjects.map((project, i) => (
      <Card
        title={project.data.title}
        description={project.data.description}
        longDescription={project.data.longDescription}
        tags={project.data.tags}
        status={project.data.status}
        url={project.data.link}
        repo={project.data.repo}
        index={i}
      />
    ))}
  </div>

  <div class="home-projects__more">
    <a
      href="https://github.com/georgejieh?tab=repositories"
      target="_blank"
      rel="noopener"
    >
      View all repositories on GitHub
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </a>
  </div>
</section>