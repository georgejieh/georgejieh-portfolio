---
const links = [
  { label: 'GitHub', href: 'https://github.com/georgejieh' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/george-jieh/' },
  { label: 'Hugging Face', href: 'https://huggingface.co/ColdAshSage' },
];
---

<ul class="home-socials" aria-label="Public profiles">
  {links.map((link) => (
    <li>
      <a href={link.href} target="_blank" rel="noopener">
        {link.label}
        <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M4 12 12 4M6 4h6v6" /></svg>
      </a>
    </li>
  ))}
</ul>