---
import { Icon } from 'astro-icon/components';
---

<div class="flex flex-wrap items-center gap-6">
  <a
    href="https://github.com/georgejieh"
    target="_blank"
    rel="noopener"
    aria-label="GitHub"
    class="flex items-center gap-2 font-mono text-sm text-muted transition-colors hover:text-accent"
  >
    <Icon class="h-5 w-5" name="mdi:github" size={24} />
    GitHub
  </a>
  <a
    href="https://www.linkedin.com/in/george-jieh/"
    target="_blank"
    rel="noopener"
    aria-label="LinkedIn"
    class="flex items-center gap-2 font-mono text-sm text-muted transition-colors hover:text-accent"
  >
    <Icon class="h-5 w-5" name="mdi:linkedin" size={24} />
    LinkedIn
  </a>
  <a
    href="https://huggingface.co/ColdAshSage"
    target="_blank"
    rel="noopener"
    aria-label="Hugging Face"
    class="flex items-center gap-2 font-mono text-sm text-muted transition-colors hover:text-accent"
  >
    <Icon class="h-5 w-5" name="mdi:robot-happy" size={24} />
    Hugging Face
  </a>
  <a
    href="mailto:contact@georgejieh.dev"
    aria-label="Email"
    class="flex items-center gap-2 font-mono text-sm text-muted transition-colors hover:text-accent"
  >
    <Icon class="h-5 w-5" name="mdi:email" size={24} />
    Email
  </a>
</div>