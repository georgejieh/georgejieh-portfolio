---
import Tags from '@components/ui/Tags.astro';

interface Props {
  url?: string;
  repo?: string;
  title?: string;
  description: string;
  longDescription?: string;
  tags: string[];
  status?: 'shipped' | 'in-progress' | 'research' | 'planned';
  index?: number;
  children?: HTMLElement | HTMLElement[];
}

const {
  url,
  repo,
  title = 'Project title',
  description = 'Project Description',
  longDescription,
  tags = [],
  status = 'in-progress',
  index = 0,
} = Astro.props;

const statusConfig = {
  'shipped': { label: 'Shipped', className: 'is-shipped' },
  'in-progress': { label: 'In progress', className: 'is-progress' },
  'research': { label: 'Research', className: 'is-research' },
  'planned': { label: 'Planned', className: 'is-planned' },
};

const sc = statusConfig[status];
const num = String(index + 1).padStart(2, '0');
const internalUrl = url && url.startsWith('/');
---

<article
  id={`project-${index + 1}`}
  data-testid="card"
  class={`home-project ${sc.className}`}
>
  <details data-testid="project-disclosure" open={index === 0}>
    <summary>
      <span class="home-project__number">{num}</span>
      <span class="home-project__status">{sc.label}</span>
      <span class="home-project__heading">
        <span class="home-project__title">{title}</span>
        <span class="home-project__description">{description}</span>
      </span>
      <span class="home-project__toggle" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
      </span>
    </summary>

    <div class="home-project__body">
      <div class="home-project__meta">
        <Tags tags={tags} />
      </div>
      <div class="home-project__detail">
        {longDescription && <p>{longDescription}</p>}
        <div class="home-project__links">
          {url && url !== repo && (
            <a
              href={url}
              aria-label={`${title} link`}
              target={internalUrl ? undefined : '_blank'}
              rel={internalUrl ? undefined : 'noopener'}
            >
              {internalUrl ? 'Open live demo' : 'Visit project'}
              <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M4 12 12 4M6 4h6v6" /></svg>
            </a>
          )}
          {repo && (
            <a
              href={repo}
              aria-label={`${title} repository`}
              target="_blank"
              rel="noopener"
            >
              View repository
              <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M4 12 12 4M6 4h6v6" /></svg>
            </a>
          )}
        </div>
      </div>
    </div>
  </details>
</article>
