---
import Tags from '@components/ui/Tags.astro';

interface Props {
  url?: string;
  repo?: string;
  title?: string;
  description: string;
  longDescription?: string;
  tags: string[];
  status?: 'shipped' | 'in-progress' | 'research' | 'planned';
  children?: HTMLElement | HTMLElement[];
}

const {
  url = '#',
  repo,
  title = 'Project title',
  description = 'Project Description',
  longDescription,
  tags = [],
  status = 'in-progress',
} = Astro.props;

const statusConfig = {
  'shipped': { label: 'Shipped', color: 'text-accent', dot: 'bg-accent' },
  'in-progress': { label: 'In Progress', color: 'text-yellow-400', dot: 'bg-yellow-400' },
  'research': { label: 'Research', color: 'text-blue-400', dot: 'bg-blue-400' },
  'planned': { label: 'Planned', color: 'text-muted', dot: 'bg-muted' },
};

const sc = statusConfig[status];
---

<article
  data-testid="card"
  class="group relative w-full rounded-xl border border-border bg-surface p-6 transition-all duration-300 hover:border-accent/40 hover:bg-surfaceLight lg:p-8"
>
  <div class="mb-3 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <span class={`inline-block h-2 w-2 rounded-full ${sc.dot}`}></span>
      <span class={`font-mono text-xs ${sc.color}`}>{sc.label}</span>
    </div>
    <div class="flex items-center gap-3">
      {repo && (
        <a
          href={repo}
          aria-label={`${title} repository`}
          target="_blank"
          rel="noopener"
          class="text-muted transition-colors hover:text-accent"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </a>
      )}
      <a
        href={url}
        aria-label={`${title} link`}
        target="_blank"
        rel="noopener"
        class="text-muted transition-colors hover:text-accent"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
        </svg>
      </a>
    </div>
  </div>

  <h3 class="mb-2 font-mono text-xl text-white transition-colors group-hover:text-accent lg:text-2xl">
    {title}
  </h3>

  <p class="mb-2 text-sm text-white/80 lg:text-base">{description}</p>

  {longDescription && (
    <p class="mb-4 text-sm text-muted lg:text-base">{longDescription}</p>
  )}

  <Tags tags={tags} />
</article>