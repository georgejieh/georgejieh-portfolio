---
import Tags from '@components/ui/Tags.astro';

interface Props {
  url?: string;
  repo?: string;
  title?: string;
  description: string;
  longDescription?: string;
  tags: string[];
  status?: 'shipped' | 'in-progress' | 'research' | 'planned';
  index?: number;
  children?: HTMLElement | HTMLElement[];
}

const {
  url = '#',
  repo,
  title = 'Project title',
  description = 'Project Description',
  longDescription,
  tags = [],
  status = 'in-progress',
  index = 0,
} = Astro.props;

const statusConfig = {
  'shipped': { label: 'Shipped', color: 'text-accent', dot: 'bg-accent' },
  'in-progress': { label: 'In Progress', color: 'text-yellow-400', dot: 'bg-yellow-400' },
  'research': { label: 'Research', color: 'text-blue-400', dot: 'bg-blue-400' },
  'planned': { label: 'Planned', color: 'text-muted', dot: 'bg-muted' },
};

const sc = statusConfig[status];
const num = String(index + 1).padStart(3, '0');
---

<article
  data-testid="card"
  class="group relative w-full border border-border bg-surface p-6 transition-all duration-300 hover:border-accent/40 hover:bg-surfaceLight lg:p-8"
>
  <div class="mb-4 flex items-center justify-between font-mono text-xs tracking-widest uppercase">
    <div class="flex items-center gap-4">
      <span class="text-muted/60">{num}</span>
      <div class="flex items-center gap-2">
        <span class={`inline-block h-2 w-2 rounded-full ${sc.dot}`}></span>
        <span class={sc.color}>{sc.label}</span>
      </div>
    </div>
    <div class="flex items-center gap-5 normal-case">
      {repo && (
        <a
          href={repo}
          aria-label={`${title} repository`}
          target="_blank"
          rel="noopener"
          class="text-muted transition-colors hover:text-accent"
        >
          &rarr; Repo
        </a>
      )}
      {url && url !== repo && (
        <a
          href={url}
          aria-label={`${title} link`}
          target="_blank"
          rel="noopener"
          class="text-muted transition-colors hover:text-accent"
        >
          &rarr; Visit
        </a>
      )}
    </div>
  </div>

  <h3 class="mb-3 font-mono text-xl text-white transition-colors group-hover:text-accent lg:text-2xl">
    {title}
  </h3>

  <p class="mb-2 text-sm leading-relaxed text-white/80 lg:text-base">{description}</p>

  {longDescription && (
    <p class="mb-4 text-sm leading-relaxed text-muted lg:text-base">{longDescription}</p>
  )}

  <Tags tags={tags} />
</article>
