<section
  data-testid="focus"
  id="focus"
  class="flex flex-col items-start justify-center py-20 md:py-28"
>
  <div class="mb-10 flex w-full items-baseline gap-4">
    <h2 class="font-mono text-sm tracking-widest text-accent uppercase">02 / Focus Areas</h2>
    <div class="h-px flex-1 bg-border"></div>
  </div>

  <div class="grid w-full gap-px overflow-hidden border border-border bg-border md:grid-cols-2 lg:grid-cols-3">
