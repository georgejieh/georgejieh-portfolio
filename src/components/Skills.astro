      <div class="group bg-black p-6 transition-colors hover:bg-surface lg:p-8">
        <h3 class="mb-3 font-mono text-base text-white transition-colors group-hover:text-accent lg:text-lg">
          {area.title}
        </h3>
        <p class="mb-4 text-sm leading-relaxed text-muted">{area.body}</p>
        <div class="flex flex-wrap gap-x-3 gap-y-1 font-mono text-xs text-muted/70">
          {area.tags.map((tag) => (
            <span class="transition-colors group-hover:text-accent/70">{tag}</span>
          ))}
        </div>
      </div>
    ))}
