---
import Footer from '@components/Footer.astro';
import Navbar from '@components/Navbar.astro';
import { SEO } from 'astro-seo';

export interface LayoutProps {
  title?: string;
  home?: boolean;
  demo?: boolean;
}

const {
  title = 'George Jieh | AI/ML Engineer & LLM Evaluation Specialist',
  home = false,
  demo = false,
} = Astro.props as LayoutProps;

const broadcast = home || demo;

const directionContract = `<!--
THESIS: George's portfolio behaves like a live public-broadcast identity, refusing terminal cosplay and card stacks.
OWN-WORLD: Electric cobalt, signal coral, acid yellow, warm white, and near-black form hard-edged fields with bold grotesk type and exact editorial rules.
STORY: A visitor meets George, understands the judgment behind his AI work, inspects selected systems, and makes contact.
FIRST VIEWPORT: A cobalt field owns the left side, the oversized name crosses its seam, the role and proof sit to the right, and Explore selected work is the primary action.
FORM: Public-broadcast identity manual, grounded direction 6, seed f4e03120.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
-->`;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth" data-testid="html">
  <head>
    <SEO
      title={title}
      description="AI/ML engineer and LLM evaluation specialist. Former Scale AI Oracle Tier trainer. RLHF training for frontier models, production AI pipelines, and multi-agent orchestration."
    />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@500;600;700;800&family=Atkinson+Hyperlegible:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://georgejieh.dev" />
    <meta property="og:title" content="George Jieh | AI/ML Engineer & LLM Evaluation Specialist" />
    <meta property="og:description" content="AI/ML engineer and LLM evaluation specialist. Former Scale AI Oracle Tier trainer. RLHF training for frontier models, production AI pipelines, and multi-agent orchestration." />
    <meta property="og:site_name" content="George Jieh" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="George Jieh | AI/ML Engineer & LLM Evaluation Specialist" />
    <meta name="twitter:description" content="AI/ML engineer and LLM evaluation specialist. Former Scale AI Oracle Tier trainer. RLHF training for frontier models, production AI pipelines, and multi-agent orchestration." />

    <!-- Structured data for search engines and AI agents -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "George Jieh",
      "url": "https://georgejieh.dev",
      "email": "contact@georgejieh.dev",
      "jobTitle": "AI/ML Engineer and LLM Evaluation Specialist",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "San Francisco",
        "addressRegion": "CA",
        "addressCountry": "US"
      },
      "alumniOf": [
        {
          "@type": "EducationalOrganization",
          "name": "University of California, Berkeley"
        },
        {
          "@type": "EducationalOrganization",
          "name": "BrainStation"
        }
      ],
      "knowsAbout": [
        "LLM Evaluation",
        "RLHF",
        "Machine Learning",
        "Python",
        "PyTorch",
        "scikit-learn",
        "H2O AutoML",
        "OpenAI API",
        "Ollama",
        "Multi-agent Orchestration",
        "Financial Analysis",
        "FINRA Securities Licensing"
      ],
      "sameAs": [
        "https://github.com/georgejieh",
        "https://www.linkedin.com/in/george-jieh",
        "https://huggingface.co/ColdAshSage"
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "George Jieh - AI/ML Engineer & LLM Evaluation Specialist",
      "url": "https://georgejieh.dev"
    })} />
  </head>
  <body
    data-surface={home ? 'portfolio-home' : demo ? 'portfolio-demo' : undefined}
    class:list={[
      'site-body font-sans text-[16px] md:text-[18px]',
      broadcast ? 'site-body--home' : 'mx-auto max-w-screen-xl bg-black px-5 text-white',
    ]}
  >
    <Fragment set:html={home ? directionContract : ''} />
    <Navbar home={broadcast} />
    <slot />
    <Footer home={broadcast} />
    <style is:global>
      img {
        content-visibility: auto;
        border-radius: 8px;
        margin: 1.5rem 0;
      }

      .site-body:not(.site-body--home) {
        background-color: #0a0e14;
        color: #c9d1d9;
      }

      .site-body:not(.site-body--home) a {
        color: #00ff9c;
        transition: color 0.2s ease;
      }

      .site-body:not(.site-body--home) a:hover {
        color: #00cc7d;
      }

      ::selection {
        background-color: rgba(0, 255, 156, 0.2);
        color: #00ff9c;
      }

      /* Scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #0a0e14;
      }
      ::-webkit-scrollbar-thumb {
        background: #2d333b;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #00cc7d;
      }
    </style>
  </body>
</html>