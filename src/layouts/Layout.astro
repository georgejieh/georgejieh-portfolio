---
import Footer from '@components/Footer.astro';
import Navbar from '@components/Navbar.astro';
import { SEO } from 'astro-seo';

export interface LayoutProps {
  title: string;
}

const { title = 'George Jieh | AI/ML Engineer & LLM Evaluation Specialist' } = Astro.props as LayoutProps;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth" data-testid="html">
  <head>
    <SEO
      title={title}
      description="AI/ML engineer and LLM evaluation specialist. Former Scale AI Oracle Tier trainer. RLHF training for frontier models, production AI pipelines, and multi-agent orchestration."
    />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://georgejieh.dev" />
    <meta property="og:title" content="George Jieh | AI/ML Engineer & LLM Evaluation Specialist" />
    <meta property="og:description" content="AI/ML engineer and LLM evaluation specialist. Former Scale AI Oracle Tier trainer. RLHF training for frontier models, production AI pipelines, and multi-agent orchestration." />
    <meta property="og:site_name" content="George Jieh" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="George Jieh | AI/ML Engineer & LLM Evaluation Specialist" />
    <meta name="twitter:description" content="AI/ML engineer and LLM evaluation specialist. Former Scale AI Oracle Tier trainer. RLHF training for frontier models, production AI pipelines, and multi-agent orchestration." />

    <!-- Structured data for search engines and AI agents -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "George Jieh",
      "url": "https://georgejieh.dev",
      "email": "contact@georgejieh.dev",
      "jobTitle": "AI/ML Engineer & LLM Evaluation Specialist",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "San Francisco",
        "addressRegion": "CA",
        "addressCountry": "US"
      },
      "alumniOf": [
        {
          "@type": "EducationalOrganization",
          "name": "University of California, Berkeley"
        },
        {
          "@type": "EducationalOrganization",
          "name": "BrainStation"
        }
      ],
      "knowsAbout": [
        "LLM Evaluation",
        "RLHF",
        "Machine Learning",
        "Python",
        "PyTorch",
        "scikit-learn",
        "H2O AutoML",
        "OpenAI API",
        "Ollama",
        "Multi-agent Orchestration",
        "Financial Analysis",
        "FINRA Securities Licensing"
      ],
      "sameAs": [
        "https://github.com/georgejieh",
        "https://www.linkedin.com/in/george-jieh",
        "https://huggingface.co/ColdAshSage"
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "George Jieh - AI/ML Engineer & LLM Evaluation Specialist",
      "url": "https://georgejieh.dev"
    })} />
  </head>
  <body
    class="mx-auto max-w-screen-xl bg-black px-5 font-sans text-white text-[16px] md:text-[18px]"
  >
    <Navbar />
    <slot />
    <Footer />
    <style is:global>
      img {
        content-visibility: auto;
        border-radius: 8px;
        margin: 1.5rem 0;
      }

      body {
        background-color: #0a0e14;
        color: #c9d1d9;
      }

      a {
        color: #00ff9c;
        transition: color 0.2s ease;
      }

      a:hover {
        color: #00cc7d;
      }

      ::selection {
        background-color: rgba(0, 255, 156, 0.2);
        color: #00ff9c;
      }

      /* Subtle grid texture */
      .grid-bg {
        background-image:
          linear-gradient(rgba(45, 51, 59, 0.15) 1px, transparent 1px),
          linear-gradient(90deg, rgba(45, 51, 59, 0.15) 1px, transparent 1px);
        background-size: 40px 40px;
      }

      /* Scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #0a0e14;
      }
      ::-webkit-scrollbar-thumb {
        background: #2d333b;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #00cc7d;
      }
    </style>
  </body>
</html>