---
import Layout from '@layouts/Layout.astro';
---

<Layout title="REED Briefs | George Jieh">
  <main>
    <div class="reed-app">
      <aside class="digest-list" aria-label="Brief list">
        <h1>REED</h1>
        <div id="reed-list" class="reed-list-body"></div>
      </aside>

      <section class="digest-reader" aria-label="Brief reader" id="reed-reader">
        <div class="loading" id="reed-loading">loading briefs...</div>
      </section>
    </div>
  </main>
</Layout>

<style is:global>
  .reed-app {
    color-scheme: dark;
    --bg: #0a0d12;
    --surface: #0f141b;
    --surface-raised: #151c25;
    --surface-inset: #07090d;
    --text: #e8edf2;
    --text-muted: #9aa5b1;
    --text-dim: #7a8595;
    --border-dark: #05070a;
    --border: #26313d;
    --border-light: #3a4755;
    --accent: #ffb000;
    --accent-soft: #302400;
    --bullish: #00d084;
    --bearish: #ff4d4d;
    --neutral: #7a8595;
    --font-sans: Tahoma, "Segoe UI", Arial, sans-serif;
    --font-mono: Consolas, "Lucida Console", "Courier New", monospace;

    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    height: 100vh;
    height: 100dvh;
    position: relative;
    overflow: hidden;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.5;
  }

  .reed-app *,
  .reed-app *::before,
  .reed-app *::after {
    box-sizing: border-box;
  }

  .reed-app a {
    color: inherit;
    font: inherit;
  }

  .reed-app a {
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 2px;
  }

  .reed-app :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* List rail */
  .reed-app .digest-list {
    overflow-y: auto;
    background: var(--surface-inset);
    border-right: 1px solid var(--border-dark);
  }

  .reed-app .digest-list h1 {
    margin: 0;
    padding: 10px 14px;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--accent);
    background: var(--surface-inset);
    border-bottom: 1px solid var(--border-dark);
    text-transform: uppercase;
    position: sticky;
    top: 0;
    z-index: 2;
  }

  .reed-app .reed-list-body {
    display: block;
  }

  .reed-app .date-header {
    position: sticky;
    top: 0;
    z-index: 1;
    padding: 6px 14px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--surface-inset);
    border-bottom: 1px solid var(--border);
  }

  .reed-app .digest-list button[role="listitem"] {
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: 100%;
    min-height: 44px;
    padding: 8px 14px;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border);
    border-left: 3px solid transparent;
    text-align: left;
    cursor: pointer;
    color: inherit;
    font: inherit;
  }

  .reed-app .digest-list button[role="listitem"]:hover {
    background: var(--surface-raised);
  }

  .reed-app .digest-list button[aria-current="true"] {
    background: var(--accent-soft);
    border-left-color: var(--accent);
  }

  .reed-app .digest-list button[aria-current="true"] .item-headline {
    color: var(--text);
    font-weight: 700;
  }

  .reed-app .item-headline {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text);
    line-height: 1.3;
  }

  .reed-app .item-time {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-dim);
  }

  .reed-app .digest-list .empty {
    padding: 16px 14px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-dim);
  }

  /* Reader pane */
  .reed-app .digest-reader {
    overflow-y: auto;
    background: var(--surface);
    padding: 20px 24px 48px;
  }

  .reed-app .reader-header {
    max-width: 900px;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }

  .reed-app .reader-header h2 {
    margin: 0 0 6px;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--text);
  }

  .reed-app .session-time {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .reed-app .executive-summary {
    max-width: 72ch;
    margin: 0 0 20px;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text);
  }

  .reed-app .story-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 900px;
    margin: 0 0 24px;
  }

  .reed-app .watch-next {
    max-width: 900px;
    margin: 0 0 24px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  .reed-app .watch-next h3 {
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .reed-app .watch-next ul {
    margin: 0;
    padding-left: 20px;
  }

  .reed-app .watch-next li {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text);
    margin-bottom: 4px;
  }

  .reed-app .digest-reader .loading,
  .reed-app .digest-reader .empty {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-dim);
    padding: 24px 0;
  }

  .reed-app .digest-reader .error {
    padding: 16px;
    border: 1px solid var(--bearish);
    border-left-width: 3px;
    color: var(--bearish);
    background: var(--surface-inset);
  }

  .reed-app .digest-reader .error p {
    margin: 0 0 12px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .reed-app .digest-reader .error button {
    padding: 6px 14px;
    background: var(--surface-raised);
    color: var(--text);
    border-top: 1px solid var(--border-light);
    border-left: 1px solid var(--border-light);
    border-right: 1px solid var(--border-dark);
    border-bottom: 1px solid var(--border-dark);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;
  }

  .reed-app .digest-reader .error button:hover {
    background: var(--accent-soft);
    color: var(--accent);
  }

  /* Market snapshot strip */
  .reed-app .market-snapshot-strip {
    max-width: 900px;
    margin: 0 0 24px;
    padding: 14px 0;
    border-top: 2px solid var(--border-dark);
    border-bottom: 2px solid var(--border-dark);
  }

  .reed-app .snapshot-tiles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }

  .reed-app .snapshot-tile {
    margin: 0;
    padding: 8px 10px;
    background: var(--surface-inset);
    border-top: 1px solid var(--border-dark);
    border-left: 1px solid var(--border-dark);
    border-right: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
  }

  .reed-app .snapshot-tile dt {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 4px;
  }

  .reed-app .snapshot-tile dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .reed-app .delayed-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    margin-left: 6px;
    vertical-align: middle;
  }

  .reed-app .snapshot-provenance {
    margin: 8px 0 0;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--text-dim);
  }

  /* Story card */
  .reed-app .story-card {
    border: 1px solid var(--border);
    border-left: 4px solid var(--sentiment-color, var(--neutral));
    background: var(--surface);
    border-radius: 2px;
  }

  .reed-app .story-body {
    padding: 12px;
  }

  .reed-app .story-body h3 {
    margin: 0 0 6px;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text);
  }

  .reed-app .story-summary {
    margin: 8px 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .reed-app .story-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 8px;
  }

  .reed-app .sentiment-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sentiment-color, var(--neutral));
  }

  .reed-app .sentiment-gauge {
    display: inline-block;
    width: 24px;
    height: 4px;
    background: var(--sentiment-color, var(--neutral));
  }

  .reed-app .ticker-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .reed-app .ticker-chip {
    display: inline-block;
    padding: 4px 8px;
    border: 1px solid var(--accent);
    border-radius: 2px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--accent);
    cursor: default;
  }

  .reed-app .ticker-chip:hover {
    border-color: var(--bullish);
    color: var(--bullish);
  }

  /* Source footer */
  .reed-app .source-footer {
    max-width: 900px;
    margin: 0 0 24px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  .reed-app .source-footer h3 {
    margin: 0 0 10px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .reed-app .source-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .reed-app .source-grid li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .reed-app .source-grid a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 2px;
  }

  .reed-app .source-grid a:hover {
    color: var(--accent);
  }

  /* Freshness + source line under the list title */
  .reed-app .reed-freshness {
    padding: 6px 14px 10px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-dim);
    background: var(--surface-inset);
    border-bottom: 1px solid var(--border-dark);
  }

  .reed-app .reed-freshness .stale {
    margin-left: 6px;
    color: var(--text-dim);
  }

  .reed-app .reed-source {
    padding: 6px 14px 10px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--text-dim);
    background: var(--surface-inset);
    border-bottom: 1px solid var(--border-dark);
  }

  /* Narrow screens */
  @media (max-width: 768px) {
    .reed-app {
      grid-template-columns: 1fr;
      grid-template-rows: 38vh minmax(0, 1fr);
    }

    .reed-app .digest-list {
      max-height: 38vh;
      border-right: none;
      border-bottom: 1px solid var(--border-dark);
    }

    .reed-app .digest-reader {
      padding: 16px 14px 40px;
    }

    .reed-app .snapshot-tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .reed-app .snapshot-tiles {
      grid-template-columns: 1fr;
    }

    .reed-app .source-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reed-app *,
    .reed-app *::before,
    .reed-app *::after {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  import {
    DATASET_BASE,
    ID_REGEX,
    esc,
    parseIndexEntries,
    validateDigestShape,
    type Digest,
    type IndexEntry,
    type Sentiment,
    type Story,
    type MarketSnapshotMeta,
    type MarketSnapshotValue,
    type Source,
  } from '../lib/reed';

  // ---- DOM handles ----
  const listEl = document.getElementById('reed-list') as HTMLElement;
  const readerEl = document.getElementById('reed-reader') as HTMLElement;

  // ---- State ----
  let entries: Array<IndexEntry & { headline?: string }> = [];
  let currentId: string | null = null;
  let didFirstLoad = false;
  let didAutoRetry = false;

  // ---- Helpers ----
  const SENTIMENT_COLORS: Record<Sentiment, string> = {
    bullish: 'var(--bullish)',
    bearish: 'var(--bearish)',
    neutral: 'var(--neutral)',
  };

  const SENTIMENT_LABELS: Record<Sentiment, string> = {
    bullish: 'Bullish',
    bearish: 'Bearish',
    neutral: 'Neutral',
  };

  const TILE_LABELS: Record<string, string> = {
    '^SPX': 'S&P 500',
    '^NDX': 'Nasdaq 100',
    '10USY.B': '10Y yield',
    '^VIX': 'VIX',
  };

  const TILE_ORDER = ['^SPX', '^NDX', '10USY.B', '^VIX'];

  function getIdFromUrl(): string | null {
    const params = new URLSearchParams(window.location.search);
    const raw = params.get('d');
    if (!raw) return null;
    if (!ID_REGEX.test(raw)) return null;
    return raw;
  }

  function setUrlId(id: string | null): void {
    const url = new URL(window.location.href);
    if (id) {
      url.searchParams.set('d', id);
    } else {
      url.searchParams.delete('d');
    }
    history.replaceState(null, '', url.toString());
  }

  function formatAsOf(asOf: string): string {
    // Expect an ISO 8601 string; produce "YYYY-MM-DD HH:MM:SS UTC".
    // Falls back to the raw string if parsing fails.
    const d = new Date(asOf);
    if (isNaN(d.getTime())) return asOf;
    const pad = (n: number) => String(n).padStart(2, '0');
    return (
      d.getUTCFullYear() +
      '-' +
      pad(d.getUTCMonth() + 1) +
      '-' +
      pad(d.getUTCDate()) +
      ' ' +
      pad(d.getUTCHours()) +
      ':' +
      pad(d.getUTCMinutes()) +
      ':' +
      pad(d.getUTCSeconds()) +
      ' UTC'
    );
  }

  function isStale(asOf: string, nowMs: number): boolean {
    const t = new Date(asOf).getTime();
    if (isNaN(t)) return false;
    return nowMs - t > 7 * 24 * 60 * 60 * 1000;
  }

  function sourceProvenanceLabel(): string {
    // DATASET_BASE is an absolute URL whose path is /datasets/<owner>/<repo>/resolve/main.
    try {
      const u = new URL(DATASET_BASE);
      const parts = u.pathname.split('/').filter(Boolean);
      // path is ["datasets", "<owner>", "<repo>", "resolve", "main"]
      const owner = parts[1] || '';
      const repo = parts[2] || '';
      if (owner && repo) return 'source: ' + u.host + '/datasets/' + owner + '/' + repo;
    } catch {
      /* fall through */
    }
    return 'source: ' + DATASET_BASE;
  }

  // ---- Render functions ----

  function renderList(
    entriesIn: Array<IndexEntry & { headline?: string }>,
    selectedId: string | null,
  ): string {
    if (entriesIn.length === 0) {
      return '<p class="empty">No digests yet.</p>';
    }

    const groups = new Map<string, Array<IndexEntry & { headline?: string }>>();
    for (const e of entriesIn) {
      const date = (e.as_of || '').slice(0, 10) || 'unknown';
      const list = groups.get(date) || [];
      list.push(e);
      groups.set(date, list);
    }
    const sortedDates = Array.from(groups.keys()).sort((a, b) => (a > b ? -1 : 1));

    let html = '';
    for (const date of sortedDates) {
      const items = groups.get(date) || [];
      html += '<div>';
      html += '<header class="date-header">' + esc(date) + '</header>';
      for (const item of items) {
        const currentAttr =
          selectedId && selectedId === item.id ? ' aria-current="true"' : '';
        const timeLabel = item.as_of || item.id;
        const headlineLabel = item.headline || item.id;
        html +=
          '<button type="button" role="listitem"' +
          currentAttr +
          ' data-id="' +
          esc(item.id) +
          '">';
        html += '<span class="item-headline">' + esc(headlineLabel) + '</span>';
        html +=
          '<time class="item-time" datetime="' +
          esc(item.as_of) +
          '">' +
          esc(timeLabel) +
          '</time>';
        html += '</button>';
      }
      html += '</div>';
    }
    return html;
  }

  function renderTile(symbol: string, value: MarketSnapshotValue): string {
    const label = TILE_LABELS[symbol] || symbol;
    const change = value.change_pct ? ' (' + esc(value.change_pct) + ')' : '';
    const dot = value.delayed
      ? '<span class="delayed-dot" aria-label="delayed"></span>'
      : '';
    return (
      '<dl class="snapshot-tile">' +
      '<dt>' +
      esc(label) +
      '</dt>' +
      '<dd>' +
      esc(value.value) +
      change +
      dot +
      '</dd>' +
      '</dl>'
    );
  }

  function renderMarketStrip(meta: MarketSnapshotMeta): string {
    const tiles = TILE_ORDER.map((sym) => {
      const v = meta.values_raw[sym];
      if (!v) return '';
      return renderTile(sym, v);
    }).join('');
    return (
      '<div class="market-snapshot-strip">' +
      '<div class="snapshot-tiles">' +
      tiles +
      '</div>' +
      '<p class="snapshot-provenance">from ' +
      esc(meta.source) +
      ' at ' +
      esc(meta.fetched_at) +
      '</p>' +
      '</div>'
    );
  }

  function renderStoryCard(story: Story): string {
    const color = SENTIMENT_COLORS[story.sentiment] || 'var(--neutral)';
    const styleAttr = ' style="--sentiment-color: ' + color + '"';
    const chips = (story.tickers || [])
      .map(
        (sym) =>
          '<span class="ticker-chip">' + esc(sym) + '</span>'
      )
      .join('');
    const labelText = SENTIMENT_LABELS[story.sentiment] || story.sentiment;
    return (
      '<article class="story-card"' +
      styleAttr +
      '>' +
      '<div class="story-body">' +
      '<h3>' +
      esc(story.headline) +
      '</h3>' +
      '<span class="sentiment-gauge" role="img" aria-label="Sentiment: ' +
      esc(labelText) +
      '"' +
      styleAttr +
      '></span>' +
      '<p class="story-summary">' +
      esc(story.summary) +
      '</p>' +
      '<div class="story-meta">' +
      '<span class="sentiment-label">' +
      esc(labelText) +
      '</span>' +
      '<div class="ticker-chips">' +
      chips +
      '</div>' +
      '</div>' +
      '</div>' +
      '</article>'
    );
  }

  function renderSourceFooter(sources: Source[]): string {
    const items = sources
      .map(
        (s) =>
          '<li><a href="' +
          esc(s.url) +
          '" target="_blank" rel="noreferrer noopener">' +
          esc(String(s.id)) +
          '. ' +
          esc(s.name) +
          '</a></li>'
      )
      .join('');
    return (
      '<footer class="source-footer">' +
      '<h3>Sources</h3>' +
      '<ol class="source-grid">' +
      items +
      '</ol>' +
      '</footer>'
    );
  }

  function renderWatchNext(items: string[]): string {
    const lis = items.map((x) => '<li>' + esc(x) + '</li>').join('');
    return (
      '<div class="watch-next">' +
      '<h3>Watch next session</h3>' +
      '<ul>' +
      lis +
      '</ul>' +
      '</div>'
    );
  }

  function renderReader(digest: Digest, freshnessIso: string): string {
    const now = Date.now();
    const stale = isStale(digest.as_of, now);
    const freshnessHtml =
      '<p class="reed-freshness" id="reed-freshness">' +
      esc(formatAsOf(freshnessIso)) +
      (stale ? '<span class="stale">(stale)</span>' : '') +
      '</p>';
    const sourceHtml =
      '<p class="reed-source" id="reed-source">' + esc(sourceProvenanceLabel()) + '</p>';

    const session = digest.session || '';
    const sessionLine =
      '<p class="session-time"><time datetime="' +
      esc(digest.as_of) +
      '">' +
      esc(session) +
      ' / ' +
      esc(digest.as_of) +
      '</time></p>';

    const storyHtml = (digest.stories || [])
      .map((s) => renderStoryCard(s))
      .join('');

    return (
      freshnessHtml +
      sourceHtml +
      '<header class="reader-header">' +
      '<h2>' +
      esc(digest.headline) +
      '</h2>' +
      sessionLine +
      '</header>' +
      '<p class="executive-summary">' +
      esc(digest.executive_summary) +
      '</p>' +
      renderMarketStrip(digest.market_snapshot_meta) +
      '<div class="story-list">' +
      storyHtml +
      '</div>' +
      renderSourceFooter(digest.sources || []) +
      renderWatchNext(digest.watch_next_session || [])
    );
  }

  function renderLoading(extra?: string): string {
    const tail = extra ? ' ' + esc(extra) : '';
    return '<div class="loading">loading briefs...' + tail + '</div>';
  }

  function renderError(message: string, retryable: boolean): string {
    const btn = retryable
      ? '<button type="button" data-retry>Retry</button>'
      : '<button type="button" data-back>back to latest</button>';
    return (
      '<div class="error">' +
      '<p>Error: ' +
      esc(message) +
      '</p>' +
      btn +
      '</div>'
    );
  }

  // ---- State transitions ----

  function setReaderHtml(html: string): void {
    readerEl.innerHTML = html;
  }

  function setListHtml(html: string): void {
    listEl.innerHTML = html;
  }

  function showLoading(extra?: string): void {
    setReaderHtml(renderLoading(extra));
  }

  function showError(message: string, retryable: boolean): void {
    setReaderHtml(renderError(message, retryable));
    setListHtml(
      retryable
        ? '<p class="empty">list unavailable</p>'
        : '<p class="empty">list unavailable</p>'
    );
  }

  function showSuccess(digest: Digest): void {
    setReaderHtml(renderReader(digest, digest.as_of));
  }

  // ---- Data fetching ----

  async function fetchJson(url: string): Promise<unknown> {
    const res = await fetch(url, { headers: { Accept: 'application/json' } });
    if (!res.ok) {
      throw new Error('HTTP ' + res.status);
    }
    return await res.json();
  }

  async function loadIndex(): Promise<IndexEntry[]> {
    const raw = await fetchJson(DATASET_BASE + '/_index.json');
    return parseIndexEntries(raw);
  }

  // Fetches a brief and returns only the headline. Used to enrich the
  // list rows with real headlines (the index carries id + as_of only).
  // Returns the id as a fallback if the brief is unreachable.
  async function loadBriefHeadline(id: string): Promise<string> {
    try {
      const brief = await loadBrief(id);
      return brief.headline || id;
    } catch {
      return id;
    }
  }

  // Fetches the index, then enriches each entry with the corresponding
  // brief's headline. The list cap is 20 entries, matching the spec.
  async function loadIndexWithHeadlines(): Promise<
    Array<IndexEntry & { headline?: string }>
  > {
    const idx = await loadIndex();
    const capped = idx.slice(0, 20);
    const headlines = await Promise.all(
      capped.map((e) => loadBriefHeadline(e.id)),
    );
    return capped.map((e, i) => ({ ...e, headline: headlines[i] }));
  }

  async function loadBrief(id: string): Promise<Digest> {
    const raw = await fetchJson(DATASET_BASE + '/' + id + '.json');
    return validateDigestShape(raw);
  }

  // ---- Orchestration ----

  async function init(): Promise<void> {
    const requestedId = getIdFromUrl();
    showLoading();

    const run = async (): Promise<void> => {
      try {
        let openId: string;
        let briefPromise: Promise<Digest>;

        if (requestedId) {
          // Deep link: fetch index (with headlines) and the open brief in parallel.
          const [idx, brief] = await Promise.all([
            loadIndexWithHeadlines(),
            loadBrief(requestedId),
          ]);
          entries = idx;
          openId = requestedId;
          setListHtml(renderList(entries, openId));
          showSuccess(brief);
          currentId = openId;
          return;
        }

        // Default load: index (with headlines) first, then latest brief.
        const idx = await loadIndexWithHeadlines();
        entries = idx;
        if (entries.length === 0) {
          showError('dataset is empty', false);
          return;
        }
        openId = entries[0].id;
        briefPromise = loadBrief(openId);
        setListHtml(renderList(entries, openId));
        const brief = await briefPromise;
        showSuccess(brief);
        currentId = openId;
      } catch (err) {
        const msg =
          err instanceof Error ? err.message : 'dataset unreachable';
        if (msg.startsWith('HTTP 404') && requestedId) {
          showError('brief ' + requestedId + ' not in dataset', false);
        } else {
          showError('dataset unreachable', true);
        }
      }
    };

    try {
      await run();
    } catch {
      // run() handles its own errors; if anything else escaped, fall through
    }

    // One automatic retry on first paint only, after a 2-second delay.
    if (!didFirstLoad && !didAutoRetry && readerEl.querySelector('.error')) {
      didAutoRetry = true;
      showLoading();
      await new Promise((r) => setTimeout(r, 2000));
      try {
        await run();
      } catch {
        /* run() handles its own errors */
      }
    }
    didFirstLoad = true;
  }

  // ---- Event wiring ----

  // List clicks set ?d=<id> and re-fetch only the reader.
  listEl.addEventListener('click', async (e: Event) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;
    const btn = target.closest('button[role="listitem"]') as HTMLElement | null;
    if (!btn) return;
    const id = btn.getAttribute('data-id');
    if (!id || !ID_REGEX.test(id)) return;
    setUrlId(id);
    currentId = id;
    // Update list selection without re-rendering the whole list shape.
    listEl
      .querySelectorAll('button[aria-current="true"]')
      .forEach((el) => el.removeAttribute('aria-current'));
    btn.setAttribute('aria-current', 'true');
    // Fetch and render the brief only; the list and freshness are unchanged.
    try {
      showLoading();
      const brief = await loadBrief(id);
      showSuccess(brief);
    } catch (err) {
      const msg = err instanceof Error ? err.message : 'dataset unreachable';
      if (msg.startsWith('HTTP 404')) {
        showError('brief ' + id + ' not in dataset', false);
      } else {
        showError('dataset unreachable', true);
      }
    }
  });

  // Reader-level clicks for retry / back-to-latest buttons.
  readerEl.addEventListener('click', async (e: Event) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;
    const retry = target.closest('button[data-retry]') as HTMLElement | null;
    if (retry) {
      showLoading();
      try {
        const idx = await loadIndexWithHeadlines();
        entries = idx;
        if (entries.length === 0) {
          showError('dataset is empty', false);
          return;
        }
        const id = currentId && entries.some((e) => e.id === currentId)
          ? currentId
          : entries[0].id;
        currentId = id;
        setUrlId(id === entries[0].id && !getIdFromUrl() ? null : id);
        setListHtml(renderList(entries, currentId));
        const brief = await loadBrief(currentId);
        showSuccess(brief);
      } catch {
        showError('dataset unreachable', true);
      }
      return;
    }
    const back = target.closest('button[data-back]') as HTMLElement | null;
    if (back) {
      setUrlId(null);
      currentId = null;
      // Reload the page state from scratch (latest brief).
      void init();
    }
  });

  // Keyboard: arrows + j/k move selection, Enter opens it, Escape clears ?d=.
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    const t = e.target;
    if (
      t instanceof HTMLInputElement ||
      t instanceof HTMLTextAreaElement ||
      t instanceof HTMLSelectElement
    ) {
      return;
    }

    if (entries.length === 0) return;
    const currentIndex = entries.findIndex((entry) => entry.id === currentId);
    let nextIndex = currentIndex;

    switch (e.key) {
      case 'ArrowDown':
      case 'j':
        e.preventDefault();
        nextIndex = currentIndex < 0 ? 0 : Math.min(entries.length - 1, currentIndex + 1);
        break;
      case 'ArrowUp':
      case 'k':
        e.preventDefault();
        nextIndex = currentIndex < 0 ? 0 : Math.max(0, currentIndex - 1);
        break;
      case 'Enter':
        // No-op: the active button already opens on click; Enter is a no-op
        // for buttons inside the list because they handle their own activation.
        return;
      case 'Escape':
        e.preventDefault();
        setUrlId(null);
        currentId = null;
        void init();
        return;
      default:
        return;
    }

    const next = entries[nextIndex];
    if (!next) return;
    setUrlId(next.id);
    currentId = next.id;
    listEl
      .querySelectorAll('button[aria-current="true"]')
      .forEach((el) => el.removeAttribute('aria-current'));
    const btn = listEl.querySelector(
      'button[data-id="' + next.id.replace(/"/g, '\\"') + '"]'
    ) as HTMLElement | null;
    if (btn) btn.setAttribute('aria-current', 'true');
    // Fetch the new brief.
    (async () => {
      try {
        showLoading();
        const brief = await loadBrief(next.id);
        showSuccess(brief);
      } catch (err) {
        const msg = err instanceof Error ? err.message : 'dataset unreachable';
        if (msg.startsWith('HTTP 404')) {
          showError('brief ' + next.id + ' not in dataset', false);
        } else {
          showError('dataset unreachable', true);
        }
      }
    })();
  });

  void init();
</script>
