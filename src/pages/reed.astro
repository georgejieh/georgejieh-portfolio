---
import Layout from '@layouts/Layout.astro';
import '../styles/home.css';
import '../styles/demo.css';
---

<Layout title="REED Briefs | George Jieh" demo>
	<main class="demo-page demo-page--reed" data-program="reed">
		<header class="demo-masthead" aria-label="REED program header">
			<a class="demo-masthead__back" href="/#projects">Portfolio / Selected work</a>
			<p class="demo-masthead__program">Program 02 / Published intelligence</p>
			<a class="demo-masthead__live" href="https://github.com/georgejieh/REED" target="_blank" rel="noopener">
				Source repository <span aria-hidden="true">↗</span>
			</a>
		</header>

		<section class="reed-intro" aria-labelledby="reed-page-title">
			<div class="reed-intro__copy">
				<p class="reed-eyebrow">Real-time Equity and Economic Digest</p>
				<h1 id="reed-page-title">REED market briefs</h1>
				<p>
					Scheduled market-news digests built from curated RSS sources before a single-turn
					LLM call. Choose a published window below, then read the sourced brief without
					leaving the portfolio.
				</p>
			</div>
			<dl class="reed-intro__facts" aria-label="REED operating model">
				<div><dt>Schedule</dt><dd>Four trading-day sessions</dd></div>
				<div><dt>Research</dt><dd>Curated RSS before inference</dd></div>
				<div><dt>Generation</dt><dd>One call, zero tools exposed</dd></div>
				<div><dt>Sources</dt><dd>Links constrained to fetched inputs</dd></div>
			</dl>
		</section>

		<div class="reed-app">
			<aside class="digest-list" aria-label="Published digest list">
				<div class="reed-list-heading">
					<div>
						<p>Broadcast archive</p>
						<h2>Published windows</h2>
					</div>
					<span aria-label="Keyboard navigation available">↑↓ / J K</span>
				</div>
				<div class="reed-colhead" aria-hidden="true">
					<span>Market window</span>
					<span>Published</span>
				</div>
				<div id="reed-list" class="reed-list-body"></div>
			</aside>

			<section class="digest-reader" aria-label="Brief reader" id="reed-reader" aria-busy="true">
				<div class="loading" role="status">Loading published briefs...</div>
			</section>

			<footer class="reed-statusbar" aria-label="REED connection status">
				<span class="sb-cell" id="sb-count">0 briefs</span>
				<span class="sb-cell sb-source">reed-portfolio-backend.onrender.com</span>
				<span class="sb-spacer"></span>
				<span class="sb-cell" id="sb-state" aria-live="polite">Loading</span>
			</footer>
		</div>
	</main>
</Layout>



<script>
	import { createReedApi, esc, type ReedDigest, type ReedDigestItem } from '../lib/reed';

	const listElement = document.getElementById('reed-list') as HTMLElement;
	const readerElement = document.getElementById('reed-reader') as HTMLElement;
	const countElement = document.getElementById('sb-count');
	const stateElement = document.getElementById('sb-state');
	const api = createReedApi();

	let digests: ReedDigest[] = [];
	let currentId: string | null = null;
	let requestSequence = 0;

	const safeProtocols = new Set(['http:', 'https:']);

	function isSafeSourceUrl(raw: string): boolean {
		try {
			return safeProtocols.has(new URL(raw).protocol);
		} catch {
			return false;
		}
	}

	function formatPublishedAt(iso: string): string {
		const value = new Date(iso);
		if (Number.isNaN(value.getTime())) return iso;
		return new Intl.DateTimeFormat('en-US', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
			hour: 'numeric',
			minute: '2-digit',
			timeZone: 'UTC',
			timeZoneName: 'short',
		}).format(value);
	}

	function getRequestedId(): string | null {
		return new URLSearchParams(window.location.search).get('d');
	}

	function setRequestedId(id: string | null): void {
		const url = new URL(window.location.href);
		if (id) url.searchParams.set('d', id);
		else url.searchParams.delete('d');
		history.replaceState(null, '', url);
	}

	function setConnectionState(text: string, className: 'sb-ok' | 'sb-error' | ''): void {
		if (!stateElement) return;
		stateElement.textContent = text;
		stateElement.classList.remove('sb-ok', 'sb-error');
		if (className) stateElement.classList.add(className);
	}

	function sortDigests(values: ReedDigest[]): ReedDigest[] {
		return [...values].sort((left, right) => {
			const leftTime = new Date(left.published_at).getTime();
			const rightTime = new Date(right.published_at).getTime();
			const safeLeft = Number.isNaN(leftTime) ? 0 : leftTime;
			const safeRight = Number.isNaN(rightTime) ? 0 : rightTime;
			return safeRight - safeLeft;
		});
	}

	function renderList(selectedId: string | null): string {
		if (digests.length === 0) return '';

		return (
			'<div role="list">' +
			'<p class="list-section-label">Published briefs</p>' +
			digests
				.map((digest) => {
					const current = digest.id === selectedId ? ' aria-current="true"' : '';
					const label =
						digest.title +
						', ' +
						digest.market_window +
						', published ' +
						formatPublishedAt(digest.published_at);
					return (
						'<div role="listitem"><button type="button" data-id="' +
						esc(digest.id) +
						'" aria-label="' +
						esc(label) +
						'"' +
						current +
						'>' +
						'<span class="item-copy">' +
						'<span class="item-window">' +
						esc(digest.market_window) +
						'</span>' +
						'<span class="item-title">' +
						esc(digest.title) +
						'</span>' +
						'</span>' +
						'<time class="item-time" datetime="' +
						esc(digest.published_at) +
						'">' +
						esc(formatPublishedAt(digest.published_at)) +
						'</time>' +
						'</button></div>'
					);
				})
				.join('') +
			'</div>'
		);
	}

	function renderSource(item: ReedDigestItem): string {
		if (!isSafeSourceUrl(item.source_url)) {
			return '<span>' + esc(item.source_name) + '</span>';
		}
		return (
			'<a href="' +
			esc(item.source_url) +
			'" target="_blank" rel="noreferrer noopener">' +
			esc(item.source_name) +
			'</a>'
		);
	}

	function renderSignals(item: ReedDigestItem): string {
		const tickers = item.tickers
			.map((ticker) => '<span class="ticker-chip">' + esc(ticker) + '</span>')
			.join('');
		return (
			'<div class="market-signals" aria-label="Market analysis">' +
			'<span class="sentiment sentiment-' + esc(item.market_sentiment) + '">' +
			esc(item.market_sentiment) +
			' implication</span>' +
			tickers +
			'</div>'
		);
	}

	function renderDigest(digest: ReedDigest, isLatest: boolean): string {
		const items = digest.items
			.map(
				(item) =>
					'<article class="news-item">' +
					'<h3>' +
					esc(item.headline) +
					'</h3>' +
					renderSignals(item) +
					'<p class="news-item-summary">' +
					esc(item.summary) +
					'</p>' +
					'<p class="market-relevance"><strong>Why it matters:</strong> ' +
					esc(item.market_relevance) +
					'</p>' +
					'<p class="news-source">' +
					renderSource(item) +
					'<time datetime="' +
					esc(item.published_at) +
					'">' +
					esc(formatPublishedAt(item.published_at)) +
					'</time>' +
					'</p>' +
					'</article>'
			)
			.join('');

		return (
			'<div class="reader-titlebar">' +
			'<strong>' +
			esc(digest.market_window) +
			'</strong>' +
			'<span class="reader-code">' +
			esc(digest.id) +
			'</span>' +
			'</div>' +
			'<header class="reader-header">' +
			'<p class="digest-label">' +
			(isLatest ? 'Latest successful published digest' : 'Historic digest') +
			'</p>' +
			'<h2>' +
			esc(digest.title) +
			'</h2>' +
			'<p class="published-line">Published <time datetime="' +
			esc(digest.published_at) +
			'">' +
			esc(formatPublishedAt(digest.published_at)) +
			'</time></p>' +
			'</header>' +
			'<p class="digest-summary">' +
			esc(digest.summary) +
			'</p>' +
			'<div class="news-list">' +
			items +
			'</div>'
		);
	}

	function showLoading(): void {
		readerElement.setAttribute('aria-busy', 'true');
		readerElement.innerHTML =
			'<div class="loading" role="status">Loading published briefs...</div>';
		setConnectionState('Loading', '');
	}

	function showEmpty(): void {
		currentId = null;
		listElement.innerHTML = '';
		readerElement.setAttribute('aria-busy', 'false');
		readerElement.innerHTML = '<div class="empty" role="status">No published brief yet.</div>';
		if (countElement) countElement.textContent = '0 briefs';
		setConnectionState('Available, no published brief', 'sb-ok');
	}

	function showUnavailable(): void {
		listElement.innerHTML = '';
		readerElement.setAttribute('aria-busy', 'false');
		readerElement.innerHTML =
			'<div class="error" role="alert">' +
			'<p>REED is unavailable. The published briefs could not be loaded.</p>' +
			'<button type="button" data-retry>Retry</button>' +
			'</div>';
		setConnectionState('Unavailable', 'sb-error');
	}

	function showDigest(digest: ReedDigest): void {
		currentId = digest.id;
		listElement.innerHTML = renderList(currentId);
		readerElement.setAttribute('aria-busy', 'false');
		readerElement.innerHTML = renderDigest(digest, digests[0]?.id === digest.id);
		if (countElement) {
			countElement.textContent = digests.length + (digests.length === 1 ? ' brief' : ' briefs');
		}
		setConnectionState('Public read available', 'sb-ok');
	}

	async function loadDigests(): Promise<void> {
		const sequence = ++requestSequence;
		showLoading();
		try {
			const loaded = sortDigests(await api.listDigests());
			if (sequence !== requestSequence) return;
			digests = loaded;
			if (digests.length === 0) {
				showEmpty();
				return;
			}
			const requestedId = getRequestedId();
			const selected = digests.find((digest) => digest.id === requestedId) ?? digests[0];
			if (requestedId && selected.id !== requestedId) setRequestedId(null);
			showDigest(selected);
		} catch {
			if (sequence !== requestSequence) return;
			showUnavailable();
		}
	}

	listElement.addEventListener('click', (event) => {
		const target = event.target as HTMLElement | null;
		const button = target?.closest('button[data-id]') as HTMLButtonElement | null;
		const id = button?.dataset.id;
		const digest = digests.find((candidate) => candidate.id === id);
		if (!digest) return;
		setRequestedId(digest.id);
		showDigest(digest);
	});

	readerElement.addEventListener('click', (event) => {
		const target = event.target as HTMLElement | null;
		if (target?.closest('button[data-retry]')) void loadDigests();
	});

	document.addEventListener('keydown', (event) => {
		if (event.metaKey || event.ctrlKey || event.altKey) return;
		if (event.target instanceof HTMLInputElement) return;
		const currentIndex = digests.findIndex((digest) => digest.id === currentId);
		const direction =
			event.key === 'ArrowDown' || event.key === 'j'
				? 1
				: event.key === 'ArrowUp' || event.key === 'k'
					? -1
					: 0;
		if (!direction || currentIndex < 0) return;
		const nextIndex = Math.max(0, Math.min(digests.length - 1, currentIndex + direction));
		if (nextIndex === currentIndex) return;
		event.preventDefault();
		const digest = digests[nextIndex];
		setRequestedId(digest.id);
		showDigest(digest);
		const button = listElement.querySelector(
			'button[data-id="' + CSS.escape(digest.id) + '"]'
		) as HTMLButtonElement | null;
		button?.focus();
		button?.scrollIntoView({ block: 'nearest' });
	});

	void loadDigests();
</script>
