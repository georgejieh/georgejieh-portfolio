---
import Layout from '@layouts/Layout.astro';
---

<Layout title="REED Briefs | George Jieh">
	<main>
		<div class="reed-app">
			<aside class="digest-list" aria-label="Published digest list">
				<div class="reed-topbar">
					<h1>REED</h1>
					<a class="reed-back" href="/">&larr; Portfolio</a>
				</div>
				<div class="reed-colhead" aria-hidden="true">
					<span>Market window</span>
					<span>Published</span>
				</div>
				<div id="reed-list" class="reed-list-body"></div>
			</aside>

			<section class="digest-reader" aria-label="Brief reader" id="reed-reader" aria-busy="true">
				<div class="loading" role="status">Loading published briefs...</div>
			</section>

			<footer class="reed-statusbar" aria-label="REED connection status">
				<span class="sb-cell" id="sb-count">0 briefs</span>
				<span class="sb-cell sb-source">reed-portfolio-backend.onrender.com</span>
				<span class="sb-spacer"></span>
				<span class="sb-cell" id="sb-state" aria-live="polite">Loading</span>
			</footer>
		</div>
	</main>
</Layout>

<style is:global>
	.reed-app {
		color-scheme: dark;
		--bg: #0a0d12;
		--surface: #0f141b;
		--surface-raised: #151c25;
		--surface-inset: #07090d;
		--text: #e8edf2;
		--text-muted: #a7b0bb;
		--text-dim: #7f8996;
		--border-dark: #05070a;
		--border: #26313d;
		--border-light: #3a4755;
		--accent: #ffb000;
		--accent-soft: #302400;
		--ok: #00d084;
		--error: #ff6262;
		--font-sans: Tahoma, 'Segoe UI', Arial, sans-serif;
		--font-mono: Consolas, 'Lucida Console', 'Courier New', monospace;

		display: grid;
		grid-template-columns: 300px minmax(0, 1fr);
		grid-template-rows: minmax(0, 1fr) auto;
		height: 100vh;
		height: 100dvh;
		overflow: hidden;
		background: var(--bg);
		color: var(--text);
		font-family: var(--font-sans);
		font-size: 14px;
		line-height: 1.5;
	}

	.reed-app *,
	.reed-app *::before,
	.reed-app *::after {
		box-sizing: border-box;
	}

	.reed-app::after {
		content: '';
		position: fixed;
		inset: 0;
		z-index: 40;
		pointer-events: none;
		background: repeating-linear-gradient(
			to bottom,
			rgba(255, 255, 255, 0.02) 0,
			rgba(255, 255, 255, 0.02) 1px,
			transparent 1px,
			transparent 3px
		);
	}

	.reed-app a {
		color: inherit;
		text-decoration: underline;
		text-decoration-style: dotted;
		text-underline-offset: 3px;
	}

	.reed-app :focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.reed-app .digest-list {
		display: grid;
		grid-template-rows: auto auto minmax(0, 1fr);
		min-height: 0;
		overflow: hidden;
		background: var(--surface-inset);
		border-right: 1px solid var(--border-dark);
	}

	.reed-app .reed-topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		border-bottom: 1px solid var(--border-dark);
	}

	.reed-app .reed-topbar h1 {
		margin: 0;
		padding: 10px 14px;
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.9375rem;
		letter-spacing: 0.12em;
	}

	.reed-app .reed-back {
		padding: 10px 14px;
		color: var(--text-dim);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-decoration: none;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.reed-app .reed-back:hover {
		color: var(--accent);
	}

	.reed-app .reed-colhead {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		background: var(--surface-raised);
		border-bottom: 1px solid var(--border-dark);
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.625rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.reed-app .reed-colhead span {
		padding: 4px 14px;
		border-top: 1px solid var(--border-light);
		border-right: 1px solid var(--border-dark);
	}

	.reed-app .reed-list-body {
		min-height: 0;
		overflow-y: auto;
	}

	.reed-app .list-section-label {
		position: sticky;
		top: 0;
		z-index: 1;
		margin: 0;
		padding: 6px 14px;
		border-bottom: 1px solid var(--border);
		background: var(--surface-inset);
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.reed-app .digest-list button[data-id] {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 10px;
		width: 100%;
		min-height: 58px;
		padding: 8px 14px;
		border: 0;
		border-bottom: 1px solid var(--border);
		border-left: 3px solid transparent;
		background: transparent;
		color: inherit;
		cursor: pointer;
		font: inherit;
		text-align: left;
	}

	.reed-app .digest-list button[data-id]:hover {
		background: var(--surface-raised);
	}

	.reed-app .digest-list button[data-id][aria-current='true'] {
		border-left-color: #fff;
		background: var(--accent);
	}

	.reed-app .digest-list button[data-id][aria-current='true'] .item-window,
	.reed-app .digest-list button[data-id][aria-current='true'] .item-title,
	.reed-app .digest-list button[data-id][aria-current='true'] .item-time {
		color: #160d00;
	}

	.reed-app .item-copy {
		min-width: 0;
	}

	.reed-app .item-window {
		display: block;
		overflow: hidden;
		color: var(--text);
		font-size: 0.8125rem;
		font-weight: 700;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.reed-app .item-title {
		display: block;
		overflow: hidden;
		color: var(--text-dim);
		font-size: 0.6875rem;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.reed-app .item-time {
		color: var(--text-dim);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		text-align: right;
	}

	.reed-app .digest-reader {
		overflow-y: auto;
		padding: 20px 24px 48px;
		border-left: 1px solid var(--border-light);
		background: var(--surface);
	}

	.reed-app .reader-titlebar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		max-width: 900px;
		margin: 0 0 14px;
		padding: 6px 12px;
		border-top: 1px solid var(--border-light);
		border-right: 1px solid var(--border-dark);
		border-bottom: 1px solid var(--border-dark);
		border-left: 1px solid var(--border-light);
		background: linear-gradient(90deg, var(--accent) 0%, #b57d00 60%, #5c3f00 100%);
		color: #160d00;
	}

	.reed-app .reader-titlebar strong {
		font-size: 0.9375rem;
	}

	.reed-app .reader-code {
		overflow: hidden;
		padding: 2px 8px;
		border: 1px solid rgba(0, 0, 0, 0.25);
		background: rgba(0, 0, 0, 0.14);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 700;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.reed-app .reader-header {
		max-width: 900px;
		margin-bottom: 18px;
		padding-bottom: 14px;
		border-bottom: 1px solid var(--border);
	}

	.reed-app .digest-label {
		margin: 0 0 6px;
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.reed-app .reader-header h2 {
		margin: 0 0 8px;
		color: var(--text);
		font-size: clamp(1.75rem, 4vw, 2.75rem);
		line-height: 1.15;
	}

	.reed-app .published-line {
		margin: 0;
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}

	.reed-app .digest-summary {
		max-width: 72ch;
		margin: 0 0 24px;
		color: var(--text);
		font-size: 0.9375rem;
		line-height: 1.65;
	}

	.reed-app .news-list {
		display: flex;
		flex-direction: column;
		gap: 12px;
		max-width: 900px;
	}

	.reed-app .news-item {
		padding: 14px 16px;
		border-top: 1px solid var(--border-dark);
		border-right: 1px solid var(--border-light);
		border-bottom: 1px solid var(--border-light);
		border-left: 4px solid var(--accent);
		background: var(--surface-raised);
	}

	.reed-app .news-item h3 {
		margin: 0 0 8px;
		color: var(--text);
		font-size: 1rem;
		line-height: 1.3;
	}

	.reed-app .news-item-summary {
		max-width: 76ch;
		margin: 0 0 8px;
		color: var(--text-muted);
		font-size: 0.875rem;
		line-height: 1.55;
	}

	.reed-app .market-signals {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin: 0 0 9px;
	}

	.reed-app .sentiment,
	.reed-app .ticker-chip {
		padding: 3px 6px;
		border: 1px solid var(--border-light);
		font-family: var(--font-mono);
		font-size: 0.625rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.reed-app .sentiment-bullish { border-color: #367c62; color: #80d7aa; }
	.reed-app .sentiment-bearish { border-color: #974e4e; color: #f3a1a1; }
	.reed-app .sentiment-mixed { border-color: #8b732e; color: #ecd377; }
	.reed-app .sentiment-neutral { border-color: #566b7e; color: #b6c4cf; }
	.reed-app .ticker-chip { color: var(--accent); background: var(--surface-inset); }

	.reed-app .market-relevance {
		max-width: 76ch;
		margin: 0 0 12px;
		color: var(--text-dim);
		font-size: 0.75rem;
		line-height: 1.5;
	}

	.reed-app .market-relevance strong { color: var(--text-muted); }

	.reed-app .news-source {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
		color: var(--text-dim);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
	}

	.reed-app .news-source a {
		color: var(--accent);
	}

	.reed-app .loading,
	.reed-app .empty {
		padding: 24px 0;
		color: var(--text-dim);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
	}

	.reed-app .error {
		max-width: 620px;
		padding: 16px;
		border: 1px solid var(--error);
		border-left-width: 3px;
		background: var(--surface-inset);
		color: var(--error);
	}

	.reed-app .error p {
		margin: 0 0 12px;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
	}

	.reed-app .error button {
		padding: 6px 14px;
		border-top: 1px solid var(--border-light);
		border-right: 1px solid var(--border-dark);
		border-bottom: 1px solid var(--border-dark);
		border-left: 1px solid var(--border-light);
		background: var(--surface-raised);
		color: var(--text);
		cursor: pointer;
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}

	.reed-app .error button:hover {
		background: var(--accent-soft);
		color: var(--accent);
	}

	.reed-app .reed-statusbar {
		grid-column: 1 / -1;
		display: flex;
		align-items: stretch;
		gap: 4px;
		padding: 3px 5px;
		border-top: 1px solid var(--border-light);
		background: var(--surface-raised);
		color: var(--text-dim);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
	}

	.reed-app .sb-cell {
		overflow: hidden;
		padding: 2px 10px;
		background: var(--surface-inset);
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.reed-app .sb-source {
		min-width: 0;
	}

	.reed-app .sb-spacer {
		flex: 1 1 auto;
	}

	.reed-app .sb-ok {
		color: var(--ok);
	}

	.reed-app .sb-error {
		color: var(--error);
	}

	@media (max-width: 760px) {
		.reed-app {
			grid-template-columns: 1fr;
			grid-template-rows: minmax(180px, 36vh) minmax(0, 1fr) auto;
		}

		.reed-app .digest-list {
			border-right: 0;
			border-bottom: 1px solid var(--border-light);
		}

		.reed-app .digest-reader {
			padding: 16px 14px 36px;
			border-left: 0;
		}

		.reed-app .reed-statusbar {
			grid-column: 1;
		}

		.reed-app .sb-source {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.reed-app *,
		.reed-app *::before,
		.reed-app *::after {
			scroll-behavior: auto !important;
		}
	}
</style>

<script>
	import { createReedApi, esc, type ReedDigest, type ReedDigestItem } from '../lib/reed';

	const listElement = document.getElementById('reed-list') as HTMLElement;
	const readerElement = document.getElementById('reed-reader') as HTMLElement;
	const countElement = document.getElementById('sb-count');
	const stateElement = document.getElementById('sb-state');
	const api = createReedApi();

	let digests: ReedDigest[] = [];
	let currentId: string | null = null;
	let requestSequence = 0;

	const safeProtocols = new Set(['http:', 'https:']);

	function isSafeSourceUrl(raw: string): boolean {
		try {
			return safeProtocols.has(new URL(raw).protocol);
		} catch {
			return false;
		}
	}

	function formatPublishedAt(iso: string): string {
		const value = new Date(iso);
		if (Number.isNaN(value.getTime())) return iso;
		return new Intl.DateTimeFormat('en-US', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
			hour: 'numeric',
			minute: '2-digit',
			timeZone: 'UTC',
			timeZoneName: 'short',
		}).format(value);
	}

	function getRequestedId(): string | null {
		return new URLSearchParams(window.location.search).get('d');
	}

	function setRequestedId(id: string | null): void {
		const url = new URL(window.location.href);
		if (id) url.searchParams.set('d', id);
		else url.searchParams.delete('d');
		history.replaceState(null, '', url);
	}

	function setConnectionState(text: string, className: 'sb-ok' | 'sb-error' | ''): void {
		if (!stateElement) return;
		stateElement.textContent = text;
		stateElement.classList.remove('sb-ok', 'sb-error');
		if (className) stateElement.classList.add(className);
	}

	function sortDigests(values: ReedDigest[]): ReedDigest[] {
		return [...values].sort((left, right) => {
			const leftTime = new Date(left.published_at).getTime();
			const rightTime = new Date(right.published_at).getTime();
			const safeLeft = Number.isNaN(leftTime) ? 0 : leftTime;
			const safeRight = Number.isNaN(rightTime) ? 0 : rightTime;
			return safeRight - safeLeft;
		});
	}

	function renderList(selectedId: string | null): string {
		if (digests.length === 0) return '';

		return (
			'<div role="list">' +
			'<p class="list-section-label">Published briefs</p>' +
			digests
				.map((digest) => {
					const current = digest.id === selectedId ? ' aria-current="true"' : '';
					const label =
						digest.title +
						', ' +
						digest.market_window +
						', published ' +
						formatPublishedAt(digest.published_at);
					return (
						'<div role="listitem"><button type="button" data-id="' +
						esc(digest.id) +
						'" aria-label="' +
						esc(label) +
						'"' +
						current +
						'>' +
						'<span class="item-copy">' +
						'<span class="item-window">' +
						esc(digest.market_window) +
						'</span>' +
						'<span class="item-title">' +
						esc(digest.title) +
						'</span>' +
						'</span>' +
						'<time class="item-time" datetime="' +
						esc(digest.published_at) +
						'">' +
						esc(formatPublishedAt(digest.published_at)) +
						'</time>' +
						'</button></div>'
					);
				})
				.join('') +
			'</div>'
		);
	}

	function renderSource(item: ReedDigestItem): string {
		if (!isSafeSourceUrl(item.source_url)) {
			return '<span>' + esc(item.source_name) + '</span>';
		}
		return (
			'<a href="' +
			esc(item.source_url) +
			'" target="_blank" rel="noreferrer noopener">' +
			esc(item.source_name) +
			'</a>'
		);
	}

	function renderSignals(item: ReedDigestItem): string {
		const tickers = item.tickers
			.map((ticker) => '<span class="ticker-chip">' + esc(ticker) + '</span>')
			.join('');
		return (
			'<div class="market-signals" aria-label="Market analysis">' +
			'<span class="sentiment sentiment-' + esc(item.market_sentiment) + '">' +
			esc(item.market_sentiment) +
			' implication</span>' +
			tickers +
			'</div>'
		);
	}

	function renderDigest(digest: ReedDigest, isLatest: boolean): string {
		const items = digest.items
			.map(
				(item) =>
					'<article class="news-item">' +
					'<h3>' +
					esc(item.headline) +
					'</h3>' +
					renderSignals(item) +
					'<p class="news-item-summary">' +
					esc(item.summary) +
					'</p>' +
					'<p class="market-relevance"><strong>Why it matters:</strong> ' +
					esc(item.market_relevance) +
					'</p>' +
					'<p class="news-source">' +
					renderSource(item) +
					'<time datetime="' +
					esc(item.published_at) +
					'">' +
					esc(formatPublishedAt(item.published_at)) +
					'</time>' +
					'</p>' +
					'</article>'
			)
			.join('');

		return (
			'<div class="reader-titlebar">' +
			'<strong>' +
			esc(digest.market_window) +
			'</strong>' +
			'<span class="reader-code">' +
			esc(digest.id) +
			'</span>' +
			'</div>' +
			'<header class="reader-header">' +
			'<p class="digest-label">' +
			(isLatest ? 'Latest successful published digest' : 'Historic digest') +
			'</p>' +
			'<h2>' +
			esc(digest.title) +
			'</h2>' +
			'<p class="published-line">Published <time datetime="' +
			esc(digest.published_at) +
			'">' +
			esc(formatPublishedAt(digest.published_at)) +
			'</time></p>' +
			'</header>' +
			'<p class="digest-summary">' +
			esc(digest.summary) +
			'</p>' +
			'<div class="news-list">' +
			items +
			'</div>'
		);
	}

	function showLoading(): void {
		readerElement.setAttribute('aria-busy', 'true');
		readerElement.innerHTML =
			'<div class="loading" role="status">Loading published briefs...</div>';
		setConnectionState('Loading', '');
	}

	function showEmpty(): void {
		currentId = null;
		listElement.innerHTML = '';
		readerElement.setAttribute('aria-busy', 'false');
		readerElement.innerHTML = '<div class="empty" role="status">No published brief yet.</div>';
		if (countElement) countElement.textContent = '0 briefs';
		setConnectionState('Available, no published brief', 'sb-ok');
	}

	function showUnavailable(): void {
		listElement.innerHTML = '';
		readerElement.setAttribute('aria-busy', 'false');
		readerElement.innerHTML =
			'<div class="error" role="alert">' +
			'<p>REED is unavailable. The published briefs could not be loaded.</p>' +
			'<button type="button" data-retry>Retry</button>' +
			'</div>';
		setConnectionState('Unavailable', 'sb-error');
	}

	function showDigest(digest: ReedDigest): void {
		currentId = digest.id;
		listElement.innerHTML = renderList(currentId);
		readerElement.setAttribute('aria-busy', 'false');
		readerElement.innerHTML = renderDigest(digest, digests[0]?.id === digest.id);
		if (countElement) {
			countElement.textContent = digests.length + (digests.length === 1 ? ' brief' : ' briefs');
		}
		setConnectionState('Public read available', 'sb-ok');
	}

	async function loadDigests(): Promise<void> {
		const sequence = ++requestSequence;
		showLoading();
		try {
			const loaded = sortDigests(await api.listDigests());
			if (sequence !== requestSequence) return;
			digests = loaded;
			if (digests.length === 0) {
				showEmpty();
				return;
			}
			const requestedId = getRequestedId();
			const selected = digests.find((digest) => digest.id === requestedId) ?? digests[0];
			if (requestedId && selected.id !== requestedId) setRequestedId(null);
			showDigest(selected);
		} catch {
			if (sequence !== requestSequence) return;
			showUnavailable();
		}
	}

	listElement.addEventListener('click', (event) => {
		const target = event.target as HTMLElement | null;
		const button = target?.closest('button[data-id]') as HTMLButtonElement | null;
		const id = button?.dataset.id;
		const digest = digests.find((candidate) => candidate.id === id);
		if (!digest) return;
		setRequestedId(digest.id);
		showDigest(digest);
	});

	readerElement.addEventListener('click', (event) => {
		const target = event.target as HTMLElement | null;
		if (target?.closest('button[data-retry]')) void loadDigests();
	});

	document.addEventListener('keydown', (event) => {
		if (event.metaKey || event.ctrlKey || event.altKey) return;
		if (event.target instanceof HTMLInputElement) return;
		const currentIndex = digests.findIndex((digest) => digest.id === currentId);
		const direction =
			event.key === 'ArrowDown' || event.key === 'j'
				? 1
				: event.key === 'ArrowUp' || event.key === 'k'
					? -1
					: 0;
		if (!direction || currentIndex < 0) return;
		const nextIndex = Math.max(0, Math.min(digests.length - 1, currentIndex + direction));
		if (nextIndex === currentIndex) return;
		event.preventDefault();
		const digest = digests[nextIndex];
		setRequestedId(digest.id);
		showDigest(digest);
		const button = listElement.querySelector(
			'button[data-id="' + CSS.escape(digest.id) + '"]'
		) as HTMLButtonElement | null;
		button?.focus();
		button?.scrollIntoView({ block: 'nearest' });
	});

	void loadDigests();
</script>
