---
import Layout from '@layouts/Layout.astro';

const presets = ['corporate', 'blog', 'services', 'ecommerce', 'news', 'saas'];
---

<Layout title="MachineRead — Live Audit | George Jieh">
  <main>
    <div class="mr-app">
      <div class="mr-brandbar">
        <div class="mr-brand">
          <span class="mr-brand-mark">MR</span>
          <span class="mr-brand-name">MachineRead</span>
        </div>
        <a class="mr-back" href="/#projects">&larr; Portfolio</a>
      </div>

      <section class="command-panel">
        <div class="command-copy">
          <p class="panel-kicker">Public Website Audit</p>
          <h1>Audit any public site the way <em>machines</em> read it</h1>
          <p>
            MachineRead scans a URL for AI crawler access, scrapability,
            <span class="mr-code">llms.txt</span>, structured data, agent-protocol
            surfaces, and the SEO signals AI retrieval still depends on. This is
            the live free Essentials tier &mdash; 13 check groups, 56 checked
            points &mdash; running through the same public API documented in the
            repository.
          </p>
          <p class="mr-fineprint">
            Anonymous &middot; rate-limited &middot; no data stored &middot;
            free-tier host may take ~30s to wake
          </p>
        </div>

        <form class="audit-form" id="audit-form">
          <label for="audit-url">Target URL</label>
          <div class="input-row">
            <input
              id="audit-url"
              type="text"
              inputmode="url"
              autocapitalize="off"
              autocorrect="off"
              spellcheck="false"
              required
              placeholder="nike.com"
            />
            <button type="submit" id="audit-submit">Run Audit</button>
          </div>

          <div class="preset-picker">
            <div class="preset-picker-heading">
              <label>Website preset</label>
              <p class="preset-picker-subtitle">
                Tunes which optional check families apply. The core 13 groups run
                for every preset.
              </p>
            </div>
            <div class="preset-chip-row" id="preset-row">
              {presets.map((p, i) => (
                <button
                  type="button"
                  class:list={['preset-chip', { active: i === 0 }]}
                  data-preset={p}
                >
                  {p}
                </button>
              ))}
            </div>
          </div>
        </form>
      </section>

      <div id="audit-status" class="loading-inline hidden">
        <div class="spinner"></div>
        <span id="audit-status-text"></span>
      </div>

      <div id="audit-error" class="error-banner hidden">
        <strong>Audit error</strong>
        <span id="audit-error-text"></span>
      </div>

      <div id="audit-results" class="report-stack hidden">
        <div class="summary-grid">
          <div class="summary-tile is-accent">
            <span>Overall</span>
            <strong id="r-overall">&ndash;</strong>
            <p id="r-overall-sub">of 100 weighted points</p>
          </div>
          <div class="summary-tile">
            <span>Essentials</span>
            <strong><span id="r-essentials">&ndash;</span>%</strong>
            <p id="r-essentials-sub"></p>
          </div>
          <div class="summary-tile">
            <span>Agent Readiness</span>
            <strong><span id="r-agent">&ndash;</span>%</strong>
            <p id="r-agent-sub"></p>
          </div>
        </div>

        <div class="panel">
          <div class="panel-heading">
            <div>
              <p class="panel-kicker">Pillar Breakdown</p>
              <h3>Where the points came from</h3>
            </div>
          </div>
          <div class="preview-bars" id="r-pillars"></div>
        </div>

        <div class="panel">
          <div class="panel-heading">
            <div>
              <p class="panel-kicker">Check Inventory</p>
              <h3>Pass / partial / fail across the run</h3>
            </div>
          </div>
          <div class="inventory-summary" id="r-counts"></div>
        </div>

        <div class="findings-panel hidden" id="r-attention-wrap">
          <div class="findings-header">
            <div>
              <p class="panel-kicker">Needs Attention</p>
              <h2>Highest-leverage fixes first</h2>
            </div>
          </div>
          <div class="action-list" id="r-attention"></div>
        </div>

        <p class="mr-fineprint">
          Compact summary via <span class="mr-code">POST /v1/audit/summary</span>.
          The full report with per-check evidence and fix guidance is
          <span class="mr-code">POST /v1/audit</span> &mdash; see the
          <a href="https://github.com/georgejieh/MachineRead-Preview" target="_blank" rel="noopener">repository</a>
          for the OpenAPI schema, MCP server card, and Agent Skill package.
        </p>
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  .mr-app {
    --font-mono: "Cascadia Code", "JetBrains Mono", "IBM Plex Mono", ui-monospace,
      SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
    --bg: #05080a;
    --bg-grid: rgba(45, 226, 152, 0.045);
    --scanline: rgba(255, 255, 255, 0.022);
    --surface: rgba(9, 16, 14, 0.88);
    --surface-solid: #0a1210;
    --surface-muted: rgba(45, 226, 152, 0.05);
    --border: rgba(45, 226, 152, 0.16);
    --border-strong: rgba(45, 226, 152, 0.34);
    --text: #d9e6dd;
    --muted: #74897c;
    --muted-strong: #a9bcae;
    --accent: #2de298;
    --accent-strong: #7dffc8;
    --accent-soft: rgba(45, 226, 152, 0.12);
    --accent-ink: #04110a;
    --green: #2de298;
    --green-soft: rgba(45, 226, 152, 0.12);
    --amber: #f5c542;
    --amber-soft: rgba(245, 197, 66, 0.12);
    --red: #ff6b6b;
    --red-soft: rgba(255, 107, 107, 0.12);
    --violet: #4cc9f0;
    --violet-soft: rgba(76, 201, 240, 0.12);
    --chart-track: rgba(151, 178, 161, 0.16);
    --shadow: 0 18px 60px rgba(0, 0, 0, 0.5);
    --glow: 0 0 22px rgba(45, 226, 152, 0.16);

    position: relative;
    display: block;
    margin: 0 auto;
    padding: 8px 0 48px;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 14px;
  }

  /* Grid texture layered behind the whole demo. */
  .mr-app::before {
    content: "";
    position: absolute;
    inset: -24px -40px;
    z-index: 0;
    pointer-events: none;
    background:
      linear-gradient(var(--bg-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--bg-grid) 1px, transparent 1px);
    background-size: 44px 44px;
  }

  .mr-app > * {
    position: relative;
    z-index: 1;
  }

  .mr-app a {
    color: var(--accent);
  }
  .mr-app a:hover {
    color: var(--accent-strong);
  }

  /* Brand bar */
  .mr-brandbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 0 20px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }
  .mr-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .mr-brand-mark {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid var(--accent);
    border-radius: 2px;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 0.04em;
    box-shadow: var(--glow);
  }
  .mr-brand-name {
    color: var(--text);
    font-size: 16px;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .mr-brand-name::after {
    content: "_";
    color: var(--accent);
    animation: mrblink 1.1s steps(2, start) infinite;
  }
  .mr-back {
    font-size: 12px;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted) !important;
  }
  .mr-back:hover {
    color: var(--accent) !important;
  }

  /* Shared panel chrome */
  .command-panel,
  .panel,
  .findings-panel {
    position: relative;
    border: 1px solid var(--border);
    border-radius: 2px;
    background: var(--surface);
    box-shadow: var(--shadow);
    backdrop-filter: blur(14px);
  }
  .command-panel::before,
  .panel::before,
  .findings-panel::before {
    content: "";
    position: absolute;
    top: -1px;
    left: -1px;
    width: 22px;
    height: 2px;
    background: var(--accent);
  }

  .panel-kicker {
    margin: 0;
    color: var(--accent);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .panel-kicker::before {
    content: "// ";
    color: var(--muted);
  }

  .mr-code {
    color: var(--accent-strong);
  }
  .mr-fineprint {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.6;
  }

  /* Command panel */
  .command-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 520px);
    gap: 28px;
    align-items: start;
    margin-bottom: 24px;
    padding: clamp(22px, 4vw, 36px);
  }
  .command-copy h1 {
    max-width: 780px;
    margin: 10px 0 14px;
    color: var(--text);
    font-size: clamp(28px, 3.6vw, 48px);
    font-weight: 780;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }
  .command-copy h1 em {
    font-style: normal;
    color: var(--accent);
  }
  .command-copy p:not(.panel-kicker) {
    max-width: 640px;
    margin: 0 0 12px;
    color: var(--muted-strong);
    font-size: 14px;
    line-height: 1.7;
  }

  .audit-form {
    display: grid;
    gap: 14px;
  }
  .audit-form label {
    color: var(--muted);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .input-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 132px;
    gap: 10px;
  }
  .input-row input {
    width: 100%;
    min-width: 0;
    border: 1px solid var(--border-strong);
    border-radius: 2px;
    background: var(--surface-solid);
    color: var(--text);
    outline: none;
    padding: 14px;
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .input-row input::placeholder {
    color: var(--muted);
  }
  .input-row input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft), var(--glow);
  }
  .input-row button {
    border: 1px solid var(--accent);
    border-radius: 2px;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-mono);
    font-weight: 780;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    min-height: 50px;
    padding: 0 16px;
    box-shadow: var(--glow);
    cursor: pointer;
    transition: background 150ms ease, box-shadow 150ms ease;
  }
  .input-row button:hover:not(:disabled) {
    background: var(--accent-strong);
    box-shadow: 0 0 30px rgba(45, 226, 152, 0.3);
  }
  .input-row button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .preset-picker {
    display: grid;
    gap: 12px;
    border-top: 1px dashed var(--border);
    padding-top: 14px;
  }
  .preset-picker-heading {
    display: grid;
    gap: 4px;
  }
  .preset-picker-subtitle {
    margin: 0;
    color: var(--muted);
    font-size: 12.5px;
    line-height: 1.5;
  }
  .preset-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .preset-chip {
    border: 1px solid var(--border);
    border-radius: 2px;
    background: var(--surface-muted);
    color: var(--muted-strong);
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 650;
    padding: 9px 12px;
    cursor: pointer;
    transition: border-color 120ms ease, background 120ms ease, color 120ms ease;
  }
  .preset-chip:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }
  .preset-chip.active {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  /* Loading + error */
  .loading-inline {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
    border: 1px solid var(--border);
    border-radius: 2px;
    background: var(--surface);
    padding: 16px 18px;
    color: var(--muted-strong);
    font-size: 13.5px;
  }
  .spinner {
    width: 26px;
    height: 26px;
    flex: 0 0 auto;
    border: 3px solid var(--chart-track);
    border-top-color: var(--accent);
    border-radius: 999px;
    animation: mrspin 850ms linear infinite;
  }
  .error-banner {
    display: grid;
    gap: 4px;
    margin-bottom: 20px;
    border: 1px solid var(--red);
    border-left-width: 3px;
    border-radius: 2px;
    background: var(--red-soft);
    padding: 14px 16px;
  }
  .error-banner strong {
    color: var(--red);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .error-banner span {
    color: var(--muted-strong);
  }

  /* Report */
  .report-stack {
    display: grid;
    gap: 24px;
  }
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .summary-tile {
    position: relative;
    min-height: 168px;
    border: 1px solid var(--border);
    border-radius: 2px;
    background: var(--surface);
    padding: 18px;
    box-shadow: var(--shadow);
  }
  .summary-tile.is-accent {
    border-color: var(--accent);
    background: var(--accent-soft);
    box-shadow: var(--glow);
  }
  .summary-tile.is-accent::before {
    content: "";
    position: absolute;
    top: -1px;
    left: -1px;
    width: 22px;
    height: 2px;
    background: var(--accent);
  }
  .summary-tile span {
    color: var(--muted);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .summary-tile strong {
    display: block;
    margin-top: 18px;
    color: var(--text);
    font-size: clamp(40px, 5vw, 64px);
    line-height: 0.9;
    font-variant-numeric: tabular-nums;
    font-weight: 780;
  }
  .summary-tile.is-accent strong {
    color: var(--accent-strong);
    text-shadow: var(--glow);
  }
  .summary-tile p {
    margin: 12px 0 0;
    color: var(--muted-strong);
    font-size: 12.5px;
    line-height: 1.5;
  }

  .panel {
    padding: 20px;
  }
  .panel-heading {
    margin-bottom: 16px;
  }
  .panel-heading h3,
  .findings-header h2 {
    margin: 4px 0 0;
    color: var(--text);
    font-size: 17px;
    font-weight: 750;
  }

  .preview-bars {
    display: grid;
    gap: 16px;
  }
  .preview-bar-row {
    display: grid;
    grid-template-columns: minmax(150px, 0.5fr) minmax(0, 1fr) 64px;
    gap: 14px;
    align-items: center;
  }
  .preview-bar-row > span:first-child {
    color: var(--muted-strong);
    font-size: 13px;
  }
  .preview-bar {
    height: 8px;
    overflow: hidden;
    border-radius: 1px;
    background: var(--chart-track);
  }
  .preview-bar div {
    height: 100%;
    background: var(--accent);
    box-shadow: var(--glow);
  }
  .preview-bar-row .bar-val {
    color: var(--text);
    font-size: 13px;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .inventory-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .inv-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    border: 1px solid var(--border);
    border-radius: 2px;
    background: var(--surface-muted);
    padding: 9px 12px;
    font-size: 12.5px;
    color: var(--muted-strong);
  }
  .inv-chip strong {
    color: var(--text);
    font-variant-numeric: tabular-nums;
    font-weight: 750;
  }
  .inv-chip.pass strong {
    color: var(--green);
  }
  .inv-chip.partial strong {
    color: var(--amber);
  }
  .inv-chip.fail strong {
    color: var(--red);
  }

  /* Findings / attention */
  .findings-panel {
    display: grid;
    gap: 18px;
    padding: 20px;
  }
  .findings-header p:not(.panel-kicker) {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 13px;
  }
  .action-list {
    display: grid;
    gap: 10px;
  }
  .action-row {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr) 64px;
    gap: 12px;
    align-items: center;
    border: 1px solid var(--border);
    border-radius: 2px;
    background: var(--surface-solid);
    padding: 12px;
  }
  .action-row .action-title strong {
    display: block;
    color: var(--text);
    font-size: 13.5px;
  }
  .action-row .action-title span {
    display: block;
    margin-top: 4px;
    color: var(--muted);
    font-size: 12px;
  }
  .action-points {
    justify-self: end;
    color: var(--text);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }
  .state-badge {
    display: inline-flex;
    min-width: 74px;
    justify-content: center;
    border: 1px solid currentColor;
    border-radius: 2px;
    font-size: 11px;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 8px;
  }
  .state-fail .state-badge {
    border-color: var(--red);
    background: var(--red-soft);
    color: var(--red);
  }
  .state-partial .state-badge,
  .state-warn .state-badge {
    border-color: var(--amber);
    background: var(--amber-soft);
    color: var(--amber);
  }

  @keyframes mrspin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes mrblink {
    50% {
      opacity: 0;
    }
  }

  @media (max-width: 1024px) {
    .command-panel {
      grid-template-columns: 1fr;
    }
    .summary-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .command-copy h1 {
      font-size: 28px;
    }
    .preview-bar-row {
      grid-template-columns: minmax(0, 1fr) 56px;
    }
    .preview-bar {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .action-row {
      grid-template-columns: 78px minmax(0, 1fr);
    }
    .action-points {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>

<script>
  const API_BASE =
    new URLSearchParams(window.location.search).get('api') ||
    'https://coldashsage-machineread.hf.space';

  const form = document.getElementById('audit-form') as HTMLFormElement;
  const urlInput = document.getElementById('audit-url') as HTMLInputElement;
  const submitBtn = document.getElementById('audit-submit') as HTMLButtonElement;
  const presetRow = document.getElementById('preset-row') as HTMLElement;
  const statusWrap = document.getElementById('audit-status') as HTMLElement;
  const statusText = document.getElementById('audit-status-text') as HTMLElement;
  const errorBox = document.getElementById('audit-error') as HTMLElement;
  const errorText = document.getElementById('audit-error-text') as HTMLElement;
  const results = document.getElementById('audit-results') as HTMLElement;

  let selectedPreset = 'corporate';
  presetRow.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.preset-chip') as HTMLElement | null;
    if (!btn) return;
    selectedPreset = btn.dataset.preset || 'corporate';
    presetRow.querySelectorAll('.preset-chip').forEach((c) => c.classList.remove('active'));
    btn.classList.add('active');
  });

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

  function normalizeUrl(raw: string): string {
    const t = raw.trim();
    if (!t) return '';
    return /^https?:\/\//i.test(t) ? t : `https://${t}`;
  }

  function setStatus(msg: string) {
    statusWrap.classList.remove('hidden');
    statusText.textContent = msg;
  }
  function fail(msg: string) {
    statusWrap.classList.add('hidden');
    errorBox.classList.remove('hidden');
    errorText.textContent = msg;
    submitBtn.disabled = false;
  }

  async function waitForBackend(): Promise<boolean> {
    const deadline = Date.now() + 90_000;
    let first = true;
    while (Date.now() < deadline) {
      try {
        const ctl = new AbortController();
        const t = setTimeout(() => ctl.abort(), 8_000);
        const res = await fetch(`${API_BASE}/health`, { signal: ctl.signal });
        clearTimeout(t);
        if (res.ok) return true;
      } catch {
        /* not up yet */
      }
      if (first) {
        setStatus('Backend is waking from sleep (free-tier host) — up to a minute');
        first = false;
      }
      await new Promise((r) => setTimeout(r, 4_000));
    }
    return false;
  }

  const pillarMeta: Record<string, string> = {
    off_site: 'Off-Site Presence',
    scrapability: 'AI Access & Scrapability',
    seo: 'Traditional SEO',
  };

  function render(data: any) {
    const s = data.scores;
    (document.getElementById('r-overall') as HTMLElement).textContent = String(s.overall.earned);
    (document.getElementById('r-overall-sub') as HTMLElement).textContent = `of ${s.overall.max} weighted points`;
    (document.getElementById('r-essentials') as HTMLElement).textContent = String(s.essentials.percent);
    (document.getElementById('r-agent') as HTMLElement).textContent = String(s.agent_readiness.percent);

    const be = data.benchmarks?.essentials;
    const ba = data.benchmarks?.agent_readiness;
    (document.getElementById('r-essentials-sub') as HTMLElement).textContent = be
      ? `p${be.percentile} vs ${be.peer_count} peers · median ${be.median_percent}%`
      : `${s.essentials.earned}/${s.essentials.max} points`;
    (document.getElementById('r-agent-sub') as HTMLElement).textContent = ba
      ? `p${ba.percentile} vs ${ba.peer_count} peers · median ${ba.median_percent}%`
      : `${s.agent_readiness.earned}/${s.agent_readiness.max} probes`;

    const pillarsEl = document.getElementById('r-pillars') as HTMLElement;
    pillarsEl.innerHTML = Object.entries(s.pillars)
      .map(([key, p]: [string, any]) => {
        const pct = p.max ? Math.round((p.earned / p.max) * 100) : 0;
        return `
          <div class="preview-bar-row">
            <span>${esc(pillarMeta[key] || key)}</span>
            <div class="preview-bar"><div style="width:${pct}%"></div></div>
            <span class="bar-val">${p.earned}/${p.max}</span>
          </div>`;
      })
      .join('');

    const c = data.checks;
    (document.getElementById('r-counts') as HTMLElement).innerHTML = `
      <span class="inv-chip pass"><strong>${c.pass}</strong> pass</span>
      <span class="inv-chip partial"><strong>${c.partial}</strong> partial</span>
      <span class="inv-chip fail"><strong>${c.fail}</strong> fail</span>
      <span class="inv-chip"><strong>${c.warn}</strong> warn</span>
      <span class="inv-chip"><strong>${c.included}</strong> checks run</span>
      <span class="inv-chip"><strong>${c.locked}</strong> locked (paid tiers)</span>`;

    const wrap = document.getElementById('r-attention-wrap') as HTMLElement;
    const list = document.getElementById('r-attention') as HTMLElement;
    const attention = data.attention || [];
    if (attention.length) {
      wrap.classList.remove('hidden');
      list.innerHTML = attention
        .map(
          (a: any) => `
          <div class="action-row state-${esc(a.state)}">
            <span class="state-badge">${esc(a.state)}</span>
            <div class="action-title">
              <strong>${esc(a.check_name)}</strong>
              <span>${esc(pillarMeta[a.pillar] || a.pillar)} · ${esc(a.effort)} effort</span>
            </div>
            <span class="action-points">${a.earned}/${a.max}</span>
          </div>`
        )
        .join('');
    } else {
      wrap.classList.add('hidden');
    }

    statusWrap.classList.add('hidden');
    results.classList.remove('hidden');
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.classList.add('hidden');
    results.classList.add('hidden');

    const target = normalizeUrl(urlInput.value);
    if (!target) {
      fail('Enter a URL to audit — for example, nike.com');
      return;
    }
    urlInput.value = target;

    submitBtn.disabled = true;
    setStatus('Contacting backend');

    const up = await waitForBackend();
    if (!up) {
      fail('Backend did not respond. It may be down or still waking — try again in a minute.');
      return;
    }

    setStatus('Auditing — fetching the site the way machines do (typically 10–30s)');
    try {
      const res = await fetch(`${API_BASE}/v1/audit/summary`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url: target, preset: selectedPreset }),
      });
      if (res.status === 429) {
        const body = await res.json().catch(() => ({}));
        fail(`Rate limit reached. Try again in ${body.retry_after ?? 'a few'} seconds.`);
        return;
      }
      if (!res.ok) {
        const body = await res.json().catch(() => ({}));
        fail(typeof body.detail === 'string' ? body.detail : `Audit failed (HTTP ${res.status}).`);
        return;
      }
      render(await res.json());
    } catch {
      fail('Network error while auditing. Check the URL and try again.');
    } finally {
      submitBtn.disabled = false;
    }
  });
</script>
