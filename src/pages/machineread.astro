---
import Layout from '@layouts/Layout.astro';
import '../styles/home.css';
import '../styles/demo.css';

const presets = ['corporate', 'blog', 'services', 'ecommerce', 'news', 'saas'];
---

<Layout title="MachineRead: Live Audit | George Jieh" demo>
  <main class="demo-page demo-page--machineread" data-program="machineread">
    <header class="demo-masthead" aria-label="MachineRead program header">
      <a class="demo-masthead__back" href="/#projects">Portfolio / Selected work</a>
      <p class="demo-masthead__program">Program 01 / Live public audit</p>
      <a class="demo-masthead__live" href="https://machineread.ai" target="_blank" rel="noopener">
        Production site <span aria-hidden="true">↗</span>
      </a>
    </header>

    <div class="mr-app">

      <section class="command-panel">
        <div class="command-copy">
          <p class="panel-kicker">MachineRead / Public website audit</p>
          <h1>Audit any public site the way <em>machines</em> read it</h1>
          <p>
            MachineRead scans a URL for AI crawler access, scrapability,
            <span class="mr-code">llms.txt</span>, structured data, agent-protocol
            surfaces, and the SEO signals AI retrieval still depends on. This is
            the live free Essentials tier. It runs 13 check groups and 56 checked
            points through the same public API documented in the repository.
          </p>
          <p class="mr-fineprint">
            Anonymous / rate-limited / no data stored / free-tier host may take
            about 30 seconds to wake
          </p>
          <p class="mr-live-note">
            <strong>MachineRead is live at
              <a href="https://machineread.ai" target="_blank" rel="noopener">machineread.ai</a>.</strong>
            The Essentials audit runs free there with no account, on
            always-on infrastructure. Use it for a real audit.
          </p>
          <p class="mr-fineprint">
            The page you are on is a portfolio demo of the same audit contract,
            kept here as a working sample. It calls a free-tier backend that
            sleeps between runs, so it is slower and more rate-limited than the
            production site.
          </p>
        </div>

        <form class="audit-form" id="audit-form" aria-labelledby="audit-form-title">
          <div class="audit-form__heading">
            <p class="panel-kicker">Run the portfolio demo</p>
            <h2 id="audit-form-title">Enter one public URL</h2>
          </div>
          <label for="audit-url">Target URL</label>
          <div class="input-row">
            <input
              id="audit-url"
              type="text"
              inputmode="url"
              autocapitalize="off"
              autocorrect="off"
              spellcheck="false"
              required
              placeholder="https://www.example.com/"
            />
            <button type="submit" id="audit-submit">Run Audit</button>
          </div>

          <div class="preset-picker">
            <div class="preset-picker-heading">
              <label>Website preset</label>
              <p class="preset-picker-subtitle">
                Tunes which optional check families apply. The core 13 groups run
                for every preset.
              </p>
            </div>
            <div class="preset-chip-row" id="preset-row">
              {presets.map((p, i) => (
                <button
                  type="button"
                  class:list={['preset-chip', { active: i === 0 }]}
                  data-preset={p}
                >
                  {p}
                </button>
              ))}
            </div>
          </div>

          <dl class="audit-form__facts" aria-label="Portfolio demo limits">
            <div><dt>Coverage</dt><dd>13 groups</dd></div>
            <div><dt>Checked points</dt><dd>56</dd></div>
            <div><dt>Storage</dt><dd>None</dd></div>
          </dl>
        </form>
      </section>

      <div id="audit-status" class="loading-inline hidden">
        <div class="spinner"></div>
        <span id="audit-status-text"></span>
      </div>

      <div id="audit-error" class="error-banner hidden">
        <strong>Audit error</strong>
        <span id="audit-error-text"></span>
      </div>

      <div id="audit-results" class="report-stack hidden">
        <div class="summary-grid">
          <div class="summary-tile is-accent">
            <span>Overall</span>
            <strong id="r-overall">--</strong>
            <p id="r-overall-sub">of 100 weighted points</p>
          </div>
          <div class="summary-tile">
            <span>Essentials</span>
            <strong><span id="r-essentials">--</span>%</strong>
            <p id="r-essentials-sub"></p>
          </div>
          <div class="summary-tile">
            <span>Agent Readiness</span>
            <strong><span id="r-agent">--</span>%</strong>
            <p id="r-agent-sub"></p>
          </div>
        </div>

        <div class="read-note">
          <b>How to read this</b>
          A low or partial score can mean the signal is genuinely missing,
          present but implemented in a way machines can't parse cleanly,
          or simply not exposed where the audit looks. A low score is a
          prompt to check, not a verdict. A pass is the reliable direction: if
          MachineRead found the signal, an agent almost certainly can too.
        </div>

        <div class="panel">
          <div class="panel-heading">
            <div>
              <p class="panel-kicker">Pillar Breakdown</p>
              <h3>Where the points came from</h3>
            </div>
          </div>
          <div class="preview-bars" id="r-pillars"></div>
        </div>

        <div class="panel">
          <div class="panel-heading">
            <div>
              <p class="panel-kicker">Check Inventory</p>
              <h3>Pass / partial / fail across the run</h3>
            </div>
          </div>
          <div class="inventory-summary" id="r-counts"></div>
        </div>

        <div class="findings-panel hidden" id="r-attention-wrap">
          <div class="findings-header">
            <div>
              <p class="panel-kicker">Needs Attention</p>
              <h2>Highest-leverage fixes first</h2>
            </div>
          </div>
          <div class="action-list" id="r-attention"></div>
        </div>

        <p class="mr-fineprint">
          Findings and fixes above come straight from the full report at
          <span class="mr-code">POST /v1/audit</span>; a compact agent-oriented
          projection is available at <span class="mr-code">POST /v1/audit/summary</span>.
          See the
          <a href="https://github.com/georgejieh/MachineRead-Preview" target="_blank" rel="noopener">repository</a>
          for the OpenAPI schema, MCP server card, and Agent Skill package, or
          the <a href="https://machineread.ai/docs" target="_blank" rel="noopener">docs</a>
          on the live site.
        </p>
      </div>
    </div>
  </main>
</Layout>



<script>
  const API_BASE =
    new URLSearchParams(window.location.search).get('api') ||
    'https://coldashsage-machineread.hf.space';

  const form = document.getElementById('audit-form') as HTMLFormElement;
  const urlInput = document.getElementById('audit-url') as HTMLInputElement;
  const submitBtn = document.getElementById('audit-submit') as HTMLButtonElement;
  const presetRow = document.getElementById('preset-row') as HTMLElement;
  const statusWrap = document.getElementById('audit-status') as HTMLElement;
  const statusText = document.getElementById('audit-status-text') as HTMLElement;
  const errorBox = document.getElementById('audit-error') as HTMLElement;
  const errorText = document.getElementById('audit-error-text') as HTMLElement;
  const results = document.getElementById('audit-results') as HTMLElement;

  let selectedPreset = 'corporate';
  presetRow.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.preset-chip') as HTMLElement | null;
    if (!btn) return;
    selectedPreset = btn.dataset.preset || 'corporate';
    presetRow.querySelectorAll('.preset-chip').forEach((c) => c.classList.remove('active'));
    btn.classList.add('active');
  });

  const esc = (s: string) => String(s ?? '').replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

  function normalizeUrl(raw: string): string {
    const t = raw.trim();
    if (!t) return '';
    return /^https?:\/\//i.test(t) ? t : `https://${t}`;
  }

  // State controller for what is on screen. Exactly one of
  // {idle, loading, error, results} is ever visible, so the spinner and the
  // error banner can never linger next to a rendered report.
  type Phase = 'idle' | 'loading' | 'error' | 'results';
  function setPhase(phase: Phase) {
    statusWrap.classList.toggle('hidden', phase !== 'loading');
    errorBox.classList.toggle('hidden', phase !== 'error');
    results.classList.toggle('hidden', phase !== 'results');
  }
  function setStatus(msg: string) {
    statusText.textContent = msg;
    setPhase('loading');
  }
  function fail(msg: string) {
    errorText.textContent = msg;
    setPhase('error');
    submitBtn.disabled = false;
  }

  // Best-effort wake for the free-tier host. Returns true once /health is OK.
  // A false result does NOT mean "give up," so the caller still attempts the
  // audit, because /health can be flaky while the audit route is already live.
  async function waitForBackend(): Promise<boolean> {
    const deadline = Date.now() + 120_000;
    let announced = false;
    while (Date.now() < deadline) {
      try {
        const ctl = new AbortController();
        const t = setTimeout(() => ctl.abort(), 8_000);
        const res = await fetch(`${API_BASE}/health`, { signal: ctl.signal });
        clearTimeout(t);
        if (res.ok) return true;
      } catch {
        /* not up yet */
      }
      if (!announced) {
        setStatus('Backend is waking from sleep (free-tier host). This can take up to a minute.');
        announced = true;
      }
      await new Promise((r) => setTimeout(r, 4_000));
    }
    return false;
  }

  const pillarMeta: Record<string, string> = {
    off_site: 'Off-Site Presence',
    scrapability: 'AI Access & Scrapability',
    seo: 'Traditional SEO',
  };

  const stateRank: Record<string, number> = { fail: 0, warn: 1, partial: 2 };

  // Render the full /v1/audit contract. The compact /summary route omits the
  // finding/fix prose, so we consume the full report to explain every failure.
  function render(data: any) {
    const pillarScores = data.pillar_scores || {};
    const pillarMax = data.pillar_max || {};
    const bench = data.benchmark || null;
    const agent = data.agent_readiness || {};
    const agentBench = agent.benchmark || null;
    const checks: any[] = Array.isArray(data.checks) ? data.checks : [];

    // Essentials % mirrors benchmark.score (free-evidence); agent % mirrors
    // agent_readiness.score. Fall back gracefully if a field is missing.
    const essPct = bench ? bench.score : null;
    const essEarned = bench ? bench.checked_score : null;
    const essMax = bench ? bench.checked_max : null;

    (document.getElementById('r-overall') as HTMLElement).textContent = String(data.overall_score ?? '--');
    (document.getElementById('r-overall-sub') as HTMLElement).textContent = 'of 100 weighted points';
    (document.getElementById('r-essentials') as HTMLElement).textContent = essPct == null ? '--' : String(essPct);
    (document.getElementById('r-agent') as HTMLElement).textContent = agent.score == null ? '--' : String(agent.score);

    (document.getElementById('r-essentials-sub') as HTMLElement).textContent = bench
      ? `p${bench.percentile} vs ${bench.benchmark_count} peers / median ${bench.median_score}%`
      : (essEarned != null ? `${essEarned}/${essMax} points` : '');
    (document.getElementById('r-agent-sub') as HTMLElement).textContent = agentBench
      ? `p${agentBench.percentile} vs ${agentBench.benchmark_count} peers / median ${agentBench.median_score}%`
      : (agent.earned != null ? `${agent.earned}/${agent.max} probes` : '');

    const pillarsEl = document.getElementById('r-pillars') as HTMLElement;
    pillarsEl.innerHTML = ['off_site', 'scrapability', 'seo']
      .map((key) => {
        const earned = pillarScores[key] ?? 0;
        const max = pillarMax[key] ?? 0;
        const pct = max ? Math.round((earned / max) * 100) : 0;
        return `
          <div class="preview-bar-row">
            <span>${esc(pillarMeta[key] || key)}</span>
            <div class="preview-bar"><div style="width:${pct}%"></div></div>
            <span class="bar-val">${earned}/${max}</span>
          </div>`;
      })
      .join('');

    // Derive the inventory counts from the check rows themselves.
    const count = (st: string) => checks.filter((c) => c.state === st).length;
    const locked = count('locked');
    const included = checks.length - locked;
    (document.getElementById('r-counts') as HTMLElement).innerHTML = `
      <span class="inv-chip pass"><strong>${count('pass')}</strong> pass</span>
      <span class="inv-chip partial"><strong>${count('partial')}</strong> partial</span>
      <span class="inv-chip fail"><strong>${count('fail')}</strong> fail</span>
      <span class="inv-chip"><strong>${count('warn')}</strong> warn</span>
      <span class="inv-chip"><strong>${included}</strong> checks run</span>
      <span class="inv-chip"><strong>${locked}</strong> locked (paid tiers)</span>`;

    // Needs Attention: every row that ran and did not fully pass, worst first,
    // each with its own plain-language finding and remediation.
    const attention = checks
      .filter((c) => c.state === 'fail' || c.state === 'partial' || c.state === 'warn')
      .sort((a, b) => {
        const sr = (stateRank[a.state] ?? 9) - (stateRank[b.state] ?? 9);
        if (sr !== 0) return sr;
        const ra = a.max_score ? a.score / a.max_score : 1;
        const rb = b.max_score ? b.score / b.max_score : 1;
        if (ra !== rb) return ra - rb;
        return String(a.check_name).localeCompare(String(b.check_name));
      });

    const wrap = document.getElementById('r-attention-wrap') as HTMLElement;
    const list = document.getElementById('r-attention') as HTMLElement;
    if (attention.length) {
      wrap.classList.remove('hidden');
      list.innerHTML = attention
        .map((a: any) => {
          const finding = a.finding ? `<p class="finding">${esc(a.finding)}</p>` : '';
          const fix = a.fix ? `<p class="fix"><b>Fix</b>${esc(a.fix)}</p>` : '';
          const detail = finding || fix ? `<div class="action-detail">${finding}${fix}</div>` : '';
          return `
          <div class="action-row state-${esc(a.state)}">
            <span class="state-badge">${esc(a.state)}</span>
            <div class="action-title">
              <strong>${esc(a.label || a.check_name)}</strong>
              <span>${esc(pillarMeta[a.pillar] || a.pillar)} / ${esc(a.effort)} effort</span>
            </div>
            <span class="action-points">${a.score}/${a.max_score}</span>
            ${detail}
          </div>`;
        })
        .join('');
    } else {
      wrap.classList.add('hidden');
    }

    setPhase('results');
  }

  // Re-entrancy guard. The free-tier host cold-starts in 30-60s, and during
  // that wait people click "Run Audit" (or hit Enter) again. Without this, a
  // second run re-shows the spinner on top of the first run's rendered report
  // and causes the "spinner + error + results all at once" symptom. One run at a time.
  let inFlight = false;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (inFlight) return;

    const target = normalizeUrl(urlInput.value);
    if (!target) {
      fail('Enter a URL to audit, for example nike.com.');
      return;
    }
    urlInput.value = target;

    inFlight = true;
    submitBtn.disabled = true;
    setStatus('Contacting backend');

    const up = await waitForBackend();
    // If /health never confirmed, try the audit anyway because the route may be live
    // even when the health probe is slow. Only a failed audit shows an error.
    setStatus(
      up
        ? 'Auditing the site the way machines do (typically 10-30s)'
        : 'Backend slow to confirm. Attempting the audit anyway.'
    );

    try {
      const ctl = new AbortController();
      const timeout = setTimeout(() => ctl.abort(), 90_000);
      let res: Response;
      try {
        res = await fetch(`${API_BASE}/v1/audit`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url: target, preset: selectedPreset }),
          signal: ctl.signal,
        });
      } finally {
        clearTimeout(timeout);
      }

      if (res.status === 429) {
        const body = await res.json().catch(() => ({}));
        fail(`Rate limit reached. Try again in ${body.retry_after ?? 'a few'} seconds.`);
        return;
      }
      if (res.status === 400 || res.status === 422) {
        const body = await res.json().catch(() => ({}));
        fail(typeof body.detail === 'string' ? body.detail : `That URL was rejected (HTTP ${res.status}).`);
        return;
      }
      if (!res.ok) {
        const body = await res.json().catch(() => ({}));
        const detail = typeof body.detail === 'string' ? `: ${body.detail}` : '';
        fail(`Audit failed (HTTP ${res.status})${detail}. The free-tier host may still be waking; try again in a minute.`);
        return;
      }
      render(await res.json());
    } catch (err) {
      const aborted = err instanceof DOMException && err.name === 'AbortError';
      fail(
        aborted
          ? 'The audit timed out. The free-tier host may be under load, so try again in a minute.'
          : "Couldn't reach the audit backend. Check your connection and the URL, then try again."
      );
    } finally {
      inFlight = false;
      submitBtn.disabled = false;
    }
  });
</script>
